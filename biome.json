{
	"$schema": "https://biomejs.dev/schemas/1.7.0/schema.json",
	"organizeImports": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"style":{
				"noNonNullAssertion": "off"
			},
			"complexity":{
				"noForEach": "off"
			},
			"correctness":{
				"noConstantCondition": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			},
			"a11y": {
				"useAltText": "off",
				"noSvgWithoutTitle": "off",
				"useButtonType": "off",
				"useKeyWithClickEvents": "off"
			}
		}
	}
}
