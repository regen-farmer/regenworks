<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Add flow to species/system: </h2>
            <form action="/species/<%= species._id %>/flows" method="POST">
                <div class="form-group">
                    <label for="flow[name]">Flow name</label>
                    <input type="text" class="form-control" name="flow[name]" placeholder="Give the flow a name" required>
                </div>
                <div class="form-group">
                    <label for="flow[type]">Flow type</label>
                    <select class="form-control" name="flow[type]">
                        <option value="output">Output</option>
                        <option value="input">Input</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="flow[unit]">Flow unit</label>
                    <select class="form-control" name="flow[unit]">
                        <option value="fiber">Fiber</option>
                        <option value="food">Food</option>
                        <option value="timber">Timber</option>
                        <option value="biomass">Biomass</option>
                        <option value="co2">co2</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="flow[timeframe]">Flow timeframe</label>
                    <select class="form-control" name="flow[timeframe]">
                        <option value="day">Days</option>
                        <option value="month">Months</option>
                        <option value="year">Years</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="flow[source]">Data source</label>
                    <input type="text" class="form-control" name="flow[source]" placeholder="Source of the data" required>
                </div>
                <div class="form-group">
                    <label for="flow[data]">Data</label>
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <input type="number" step=".01" class="form-control" name="flow[data]" placeholder="Source of the data">
                    <div id="container"></div>
                    <button type="button" class="btn btn-primary add_form_field" onclick="addFields()">Add New Field &nbsp;
                        <span style="font-size:16px; font-weight:bold;">+ </span>
                    </button>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Add flow data</button>
                </div>
            </form>
        </div>
        <div class="col-lg-3"></div>
    </div>

<% include ../partials/footer %>