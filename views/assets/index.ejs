<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1>Your assets</h1>
    <p>Assets is items of value on your land. This can be anything from animals, plants and fungi to equipment, compost and seeds.</p>
    <div class="row">
        <div class="col-md-6 col-sm-6">
            <div class="thumbnail">
                <div class="caption">
                    <div class="row">
                        <% assets.forEach(function(asset){ %>
                            <div class="col-md-12">
                                <a href="/assets/<%= asset._id %>" class="btn btn-default btn-block">
                                    <p><%= asset.name %></p>
                                </a>
                            </div>
                        <% }); %>
                        <div class="col-md-12">
                            <a href="/assets/new" class="btn btn-success btn-block">
                                <p>Add new asset</p>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<% include ../partials/footer %>