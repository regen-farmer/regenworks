<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8">
        <h1>Edit asset</h1>
        <form action="/assets/<%= asset._id %>?_method=PUT" method="POST">
            <div class="form-group">
                <label for="asset[name]">Asset name</label>
                <input type="text" class="form-control" name="asset[name]" value="<%= asset.name %>" required>
            </div>
            <div class="form-group">
                <label for="asset[species]">Species</label>
                <input type="text" class="form-control" name="asset[species]" value="<%= asset.species %>">
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-success btn-lg center-block">Update asset</button>
            </div>
        </form>
    </div>
    <div class="col-lg-2"></div>
</div>

<% include ../partials/footer %>