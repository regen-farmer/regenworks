<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h2>Add a new asset</h2>
            <div>
                <form action="/assets" method="POST">
                    <p>Add a new asset to your farm.</p>
                    <div class="form-group">
                        <label for="asset[name]">Asset name</label>
                        <input type="text" class="form-control" name="asset[name]" placeholder="Give the asset a name" required>
                    </div>
                    <div class="form-group">
                        <label for="asset[description]">Asset description</label>
                        <input type="text" class="form-control" name="asset[description]" placeholder="Give the asset a description" required>
                    </div>
                    <div class="form-group">
                        <label for="asset[type]">Asset type</label>
                        <select class="form-control" name="asset[type]">
                            <option value="plant">Plants</option>
                            <option value="animals">Animals</option>
                            <option value="compost">Compost</option>
                            <option value="fungi">Fungi</option>
                            <option value="insects">Insects</option>
                            <option value="equipment">Equipment</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="asset[species]">Asset variety/species (Optional)</label>
                        <input type="text" class="form-control" name="asset[species]" placeholder="Define the breed, variety, sub-type...">
                    </div>
                    <div class="form-group">
                        <label for="asset[layer]">Layer reference (Where is the asset located?)</label>
                        <p><em><small>NB! Be sure you have created the appropriate layer on your
                                    <a href="/parcels">parcel</a> before you create the asset.</small></em></p>
                        <select class="form-control" name="asset[layer]">
                            <% layers.forEach (function(layer){ %>
                                <option value="<%= layer._id %>"><%= layer.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-success btn-lg">Create task</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-2"></div>
    </div>
</div>

<% include ../partials/footer %>