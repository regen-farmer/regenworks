<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-4"></div>
        <div class="col-lg-4">
            <h2>Opret bruger</h2>
            <form action="/users" method="POST">
                <div class="input-group center-block">
                    <input class="form-control" type="text" name="user[username]" placeholder="brugernavn">
                </div>
                <div class="input-group center-block">
                    <input class="form-control" type="email" name="user[email]" placeholder="email">
                </div>
                <div class="input-group center-block">
                    <input class="form-control" type="password" name="user[password]" placeholder="kodeord">
                </div>
                <button type="submit" class="btn btn-success center-block">Opret</button>
            </form>
        </div>
        <div class="col-lg-4"></div>
    </div>
</div>

<% include ../partials/footer %>