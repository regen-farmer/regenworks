<% include ../partials/header %>
<% include ../partials/simplenavbar.ejs %>

<div class="container">
    <div class="row">
        <div class="col-lg-4"></div>
        <div class="col-lg-4">
            <h2 class="text-center">Sign Up</h2>
            <form action="/users" method="POST">
                <div class="form-group center-block">
                    <input class="form-control" type="text" name="username" placeholder="username">
                </div>
                <div class="form-group center-block">
                    <input class="form-control" type="email" name="email" placeholder="email">
                </div>
                <div class="form-group center-block">
                    <input class="form-control" type="password" name="password" placeholder="password">
                </div>
                <div class="form-group center-block">
                    <input class="form-control" type="text" name="secret" placeholder="secret">
                </div>
                <p><em><small>By signing up you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.</small></em></p>

                <button type="submit" class="btn btn-success center-block">Sign up</button>
            </form>
        </div>
        <div class="col-lg-4"></div>
    </div>
</div>

<% include ../partials/footer %>