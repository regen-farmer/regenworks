<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <h1><i class="fas fa-heart 5x" style="color:#5cb85c"></i> Dine favoritter</h1>
            <div class="row" style="display:flex; flex-wrap: wrap;">
                <% user.favorites.forEach(function(favoritePlace){ %>
                    <div class="col-md-4 col-sm-6">
                        <div class="thumbnail">
                            <img class="img-responsive" src="<%= favoritePlace.image %>">
                            <div class="caption">
                                <p class="type"> <%= favoritePlace.type %> </p>
                                <h4> <%= favoritePlace.name %> </h4>
                                <p>
                                    <a href="/places/<%= favoritePlace._id %>" class="btn btn-success">Mere Info</a>
                                    <form action="/users/<%= currentUser._id %>/favorites/edit" method="POST">
                                        <input type="hidden" name="placeID" value="<%= favoritePlace._id %>">
                                        <button class="btn btn-default"><i class="fas fa-heart"></i> Fjern favorit</button>
                                    </form>
                                </p>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
            <% if(!(user.places == "")){ %>
                <hr>
                <h1><i class="fas fa-home 5x" style="color:#5cb85c"></i> Dine steder</h1>
            <% } %>
            <div class="row" style="display:flex; flex-wrap: wrap;">
                <% user.places.forEach(function(Place){ %>
                    <div class="col-md-4 col-sm-6">
                        <div class="thumbnail">
                            <img class="img-responsive" src="<%= Place.image %>">
                            <div class="caption">
                                <p class="type"> <%= Place.type %> </p>
                                <h4> <%= Place.name %> </h4>
                                <p>
                                    <a href="/places/<%= Place._id %>" class="btn btn-success">Mere Info</a>
                                </p>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
        <div class="col-lg-4">
            <h1><i class="fas fa-user 5x" style="color:#5cb85c"></i> Din profil</h1>
            <hr>
            <p>Brugernavn: <%= user.username %></p>
            <hr>
            <a class="btn btn-warning" href="/forgot">Nulstil kodeord</a>
            <hr>
            <a class="btn btn-warning" href="/users/<%= user._id %>/edit">Rediger profil</a>
            <hr>
        </div>
    </div>
</div>

<% include ../partials/footer %>