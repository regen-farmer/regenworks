<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <h1><i class="fas fa-heart 5x" style="color:#5cb85c"></i> Dine favoritter</h1>
            <hr>
            <h1>Dine steder</h1>
            <div class="row" style="display:flex; flex-wrap: wrap;">
                <% places.forEach(function(places){ %>
                <div class="col-md-4 col-sm-6">
                    <div class="thumbnail">
                        <img class="img-responsive" src="<%= places.image %>">
                        <div class="caption">
                            <p class="type"> <%= places.type %> </p>
                            <h4> <%= places.name %> </h4>
                            <p>
                                <a href="/places/<%= places._id %>" class="btn btn-success">Mere Info</a>
                            </p>
                        </div>
                    </div>
                </div>
                <% }); %>
            </div>
            <hr>
            <h1>Dine oplevelser</h1>
            <hr>
            <h1>Dine ydelser</h1>
        </div>
        <div class="col-lg-4">
            <h1><i class="fas fa-user 5x" style="color:#5cb85c"></i> Din profil</h1>
            <hr>
            <p>Brugernavn: <%= user.username %></p>
            <hr>
            <a class="btn btn-warning" href="/forgot">Nulstil kodeord</a>
            <hr>
            <a class="btn btn-warning" href="/users/<%= user._id %>/edit">Rediger profil</a>
            <hr>
        </div>
    </div>
</div>

<% include ../partials/footer %>