<% include ./partials/header %>
<% include ./partials/navbar %>

    <h1>System species consortium for <%= system.name %></h1>
    <p>Analyse the succession of the system to fill potential gaps.</p>
    <p><i>Shown results are based on the location of the farm.</i></p>
    <table class="table table-striped">
        <tr>
            <td></td>
            <td>Pioneer</td>
            <td>Secondary</td>
            <td>Climax</td>
        </tr>
        <tr>
            <td>Emergent</td>
            <td><% species.forEach(function(species){ %>
                <% if(species.form == "grass"){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "grass"){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "herb" && species.height > 1 && species.lifespan < 2){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "herb" && species.height > 1 && species.lifespan < 2){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height > 29 && species.lifespan < 80){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height > 29 && species.lifespan < 80){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height > 29 && species.lifespan > 79){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height > 29 && species.lifespan > 79){ %>
                    <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
        </tr>
        <tr>
            <td>High</td>
            <td>
                <% species.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan < 4){ %>
                <p><strong><%= species.nameCommon %></strong></p>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan < 4){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if(species.form == "giantherb" ){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "giantherb")){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 30 && species.height > 10 && species.lifespan < 80 ){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 30 && species.height > 10 && species.lifespan < 80 ){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 30 && species.height > 10 && species.lifespan > 79){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 30 && species.height > 10 && species.lifespan > 79){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
        </tr>
        <tr>
            <td>Medium</td>
            <td>
                <% species.forEach(function(species){ %>
                <% if(species.form == "herb" && species.height < 1.1 && species.lifespan < 2){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "herb" && species.height < 1.1 && species.lifespan < 2){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 11 && species.lifespan < 80){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 11 && species.lifespan < 80){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan < 80 && species.lifespan > 3){ %>
                <p><strong><%= species.nameCommon %></strong></p>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan < 80 && species.lifespan > 3){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "herb" && species.lifespan > 2 && species.height > 1){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "herb" && species.lifespan > 2 && species.height > 1){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 11 && species.lifespan > 79){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height < 11 && species.lifespan > 79){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan > 79){ %>
                <p><strong><%= species.nameCommon %></strong></p>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "shrub" && species.lifespan > 79){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
        </tr>
        <tr>
            <td>Low</td>
            <td></td>
            <td>
                <% species.forEach(function(species){ %>
                <% if(species.form == "succulent" || species.form == "cactus" ){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "succulent" || species.form == "cactus" ){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "herb" && species.lifespan > 2 && species.height < 1.1){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "herb" && species.lifespan > 2 && species.height < 1.1){ %>
                <p data-toggle="tooltip" data-placement="left" title="<%= species.utilities[0] %>"
                ><i><%= species.nameCommon %></i></p>
                <% } %>
                <% }); %>
            </td>
            <td>
            </td>
        </tr>
    </table>

<% include ./partials/footer %>