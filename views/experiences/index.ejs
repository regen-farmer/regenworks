<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1>Lokale arrangementer og oplevelser</h1>
    <h2>Find oplevelser nær dig</h2>
    <form action="/experiences/search" method="POST">
        <div class="input-group">
            <input class="form-control" type="text" name="locationexp" placeholder="Skriv adresse, by eller postnummer" required>
            <span class="input-group-btn">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Søg!</button>
            </span>
        </div>
    </form>
    <h2>Oversigt</h2>
    <p>Her finder du et overblik over spændende arrangementer med lokale fødevarer, idylliske oplevelser på landet og afstressende naturoplevelser.
    </p>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% experiences.forEach(function(experience){ %>
        <div class="col-md-3 col-sm-6">
            <div class="thumbnail">
                <div class="caption">
                    <h4> <%= experience.name %> </h4>
                    <p> <%= experience.day %> <%= experience.month %> kl. <%= experience.start.time %> </p>
                    <a href="/experiences/<%= experience._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                    <% if(!(experience.price === "")){ %>
                        <p> <%= experience.price %> kr. pr. person </p>
                    <% } else { %>
                        <p> gratis </p>
                    <% } %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<% include ../partials/footer %>