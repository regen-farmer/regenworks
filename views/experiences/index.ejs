<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1>Find lokale arrangementer og oplevelser</h1>
    <p>Her finder du et overblik over spændende arrangementer med fokus på økologiske fødevarer og bæredygtige lokale fællesskaber.
    </p>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% experiences.forEach(function(experience){ %>
        <div class="col-md-3 col-sm-6">
            <div class="thumbnail">
                <div class="caption">
                    <h4> <%= experience.name %> </h4>
                    <p> <%= experience.start.date %> kl. <%= experience.start.time %> </p>
                    <a href="/experiences/<%= experience._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                    <% if(!(experience.price === "")){ %>
                        <p> <%= experience.price %> kr. pr. person </p>
                    <% } else { %>
                        <p> gratis </p>
                    <% } %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<% include ../partials/footer %>