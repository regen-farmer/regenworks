<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Rediger oplevelsen "<%= experience.name %>"</h2>
            <div>
                <form action="/experiences/<%= experience._id %>?_method=PUT" method="POST">
                    <p>Her kan du opdatere din oplevelse.</p>
                    <div class="form-group">
                        <label for="experience[name]">Titel</label>
                        <input type="text" class="form-control" name="experience[name]" value="<%= experience.name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="experience[description]">Beskrivelse</label>
                        <input type="text" class="form-control" name="experience[description]" value="<%= experience.description %>">
                    </div>
                    <div class="form-group">
                        <label for="experience[location]">Adresse</label>
                        <input type="text" class="form-control" name="experience[location]" value="<%= experience.location %>" required>
                    </div>
                    <div class="form-group">
                        <label for="experience[start][date]">Tidspunkt</label>
                        <input type="date" class="form-control" name="experience[start][date]" value="<%= experience.start.date %>" required>
                        <input type="time" class="form-control" name="experience[start][time]" value="<%= experience.start.time %>">
                    </div>
                    <div class="form-group">
                        <label for="experience[price]">Pris: Udfyldes ikke hvis gratis</label>
                        <input type="text" class="form-control" name="experience[price]" value="<%= experience.price %>">
                    </div>
                    <div class="form-group">
                        <label for="experience[action]">Billetter eller tilmelding</label>
                        <input type="text" class="form-control" name="experience[action]" value="<%= experience.action %>">
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-success btn-lg">Opdater oplevelse</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<% include ../partials/footer %>