<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div>
                <h1> <%= experience.name %> </h1>
                <p> <%= experience.type %> </p>
                <hr>
                <p><%= experience.description %></p>
                <hr>
                <p><i class="fas fa-map-marker"></i> <%= experience.location %></p>
                <hr>
                <p><%= day %> <%= month %> kl. <%= experience.start.time %></p>
                <hr>
                <% if(!(experience.action === "")){ %>
                    <a class="btn btn-primary action-btn pull-right" href="<%= experience.action %>" target="_blank">Find billetter/Tilmeld</a>
                <% } else { %>
                    <p>Tilmedling ikke nødvendig</p>
                <% } %>
                <% if(!(experience.price === "")){ %>
                    <p> <%= experience.price %> kr. pr. person </p>
                <% } else { %>
                    <p> gratis </p>
                <% } %>
                <hr>
                <% if(currentUser && experience.owner.id.equals(currentUser._id)){ %>
                    <a class="btn btn-warning" href="/experiences/<%= experience._id %>/edit">Rediger</a>
                    <form class="delete-form" action="/experiences/<%= experience._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Slet</button>
                    </form>
                <% } %>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>
</div>


<% include ../partials/footer %>