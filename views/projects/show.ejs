<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1> <%= project.name %> </h1>
    <div class="row">
        <div class="col-md-4">
            <p><%= project.description %></p>
            <% if(currentUser && project.owner.id.equals(currentUser._id)){ %>
            <a class="btn btn-outline-primary" href="#">Edit project</a>
            <form class="delete-form" action="/projects/<%= project._id %>?_method=DELETE" method="POST">
                <button class="btn btn-outline-danger">Delete project</button>
            </form>
            <% } %>
        </div>
        <div class="col-md-8">
            <div>
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title">Project activities</h2>
                        <p class="card-text">-- COMING SOON --</p>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title">Project progress</h2>
                        <p class="card-text">-- COMING SOON --</p>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title">Project finances</h2>
                        <p class="card-text">-- COMING SOON --</p>
                    </div>
                </div>
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title">Project system and layout</h2>
                        <p class="card-text">-- COMING SOON --</p>

                        <a href="/projects/<%= project._id %>/layout" class="btn btn-primary">Setup layout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<% include ../partials/footer %>