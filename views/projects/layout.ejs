            <div class="card-body">
                <h2>Tree and shrub counts</h2>
                <div class="card">
                    <div class="card-body">
                        <% species.forEach(function(species){ %>
                        <p><%= species.id %> count: <%= species.uniqueCount %></p>
                        <% }); %>
                    </div>
                </div>
                <% if(edgespecies && edgespecies.length > 0){ %>
                    <div class="card">
                        <div class="card-body">
                            <p><strong>Edge system species</strong></p>
                            <% edgespecies.forEach(function(species){ %>
                            <p><%= species.id %> count: <%= species.uniqueCount %></p>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
                <h2>Area sizes</h2>
                <p>Total area: <%= (project.layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
                <p>Total tree row strip area (Approximation): <%= treeArea.toFixed(0) %> m2</p>
                <p>Headland and margin: <%= marginArea.toFixed(0) %> m2</p>
                <p>Rest (Approximation): <%= project.layer.size.toFixed(0) - treeArea.toFixed(0) - marginArea.toFixed(0) %> m2</p>
                <h2>Row lengths</h2>
                <% rowLengthArray.forEach(function(row, i){ %>
                    <p>Row <%= i + 1 %>: <%= row.toFixed(2) %> m</p>
                <% }); %>
            </div>
        </div>
        <div class="col-md-3">
            <h2>System layout</h2>
            <div class="row">
                <% if(system.sortedrows.length > 0){ %>
                    <% system.sortedrows.forEach(function(row){ %>
                        <% if(!(row.array[0].species.nameCommon === "Ryegrass")){ %>
                            <div class="col-sm-3">
                                <% row.array.forEach(function(species){ %>
                                    <img class="img-fluid" src="/images/<%= species.species.form %>top.svg">
                                    <p class="text-center"><%= species.species.nameCommon %></p>
                                <% }); %>
                            </div>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>
            <p><i><%= project.system.name %></i></p>
            <p>Total system width: <%= rowWidth %> m</p>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5>Change parameters</h5>
                    <form action="/projects/<%= project._id %>/layout?_method=PUT" method="POST">
                        <div class="form-group">
                            <label for="project[layout]">Layout type</label>
                            <select class="form-control" name="project[layout]">
                                <% if(project.layout === "straight") { %>
                                <option selected="selected" value="straight">Straight rows</option>
                                <% } else { %>
                                <option value="straight">Straight rows</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="project[alignment]">Alignment</label>
                            <select class="form-control" name="project[alignment]">
                                <% if(project.alignment === "bearing") { %>
                                    <option selected="selected" value="bearing">Angled rows</option>
                                <% } else { %>
                                    <% if(project.alignment === "north") { %>
                                        <option selected="selected" value="north">North/south</option>
                                    <% } else { %>
                                        <option value="north">North/south</option>
                                    <% } %>
                                    <% if(project.alignment === "west") { %>
                                        <option selected="selected" value="west">West/East</option>
                                    <% } else { %>
                                        <option value="west">West/East</option>
                                    <% } %>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="project[headland]">Headland</label>
                            <input type="number" min="0" max="<%= rowWidth %>" class="form-control" name="project[headland]" value="<%= project.headland %>">
                        </div>
                        <div class="btn-group">
                            <button type="submit" class="btn btn-outline-primary">Update parameters</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<script>
    var areaLat = "<%= project.layer.lat %>";
    var areaLng = "<%= project.layer.lng %>";

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var edgetrees = "<%= edgetrees %>";
    var correctedgetrees = JSON.parse(edgetrees.replace(/&#34;/g,'"'));

    var col = "<%= collection %>";
    var correctcol = JSON.parse(col.replace(/&#34;/g,'"'));

    var edgecol = "<%= edgecollection %>";
    var correctedgecol = JSON.parse(edgecol.replace(/&#34;/g,'"'));

    var getgeometry = "<%= project.layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 15,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#7F22C0',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map1',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data':
                    correctcol
            },
            'layout': {},
            'paint': {
                'line-color': '#fff1ff',
            }
        });

        map.addLayer({
            'id': 'map3',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data':
                correctedgecol
            },
            'layout': {},
            'paint': {
                'line-color': '#fff1ff',
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#5cb85c'
            }
        });

        map.addLayer({
            'id': 'map4',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctedgetrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#002eff'
            }
        });
    });

</script>

<% include ../partials/footer %>