<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-5">
            <div id="layerMapShow"></div>
            <a href="/projects/<%= project._id %>" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to project page</a>
            <% if(project.rows && project.rows.length > 0){ %>
                <a href="/projects/<%= project._id %>/row/new" class="btn mt-2 mb-2 btn-outline-success">Manually add row <i class="fas fa-plus"></i></a>
            <% } else { %>
                <button type="button" class="btn btn-outline-secondary" data-toggle="modal" data-target="#myModalExplode">Explode layout modal <i class="fas fa-expand"></i></button>
                <!-- Modal -->
                <div class="modal fade" id="myModalExplode" role="dialog">
                    <div class="modal-dialog">
                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                                <h4 class="modal-title">Confirm explode layout</h4>
                            </div>
                            <div class="modal-body">
                                <p>Once you explode the layout individual rows, areas and tree assets will automatically be created. This makes it possible to further detail plan individual rows and areas, but the location of rows and area will be locked.</p>
                            </div>
                            <div class="modal-footer">
                                <a href="/projects/<%= project._id %>/explode" class="btn mt-2 mb-2 btn-outline-primary">Confirm explode layout</a>
                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
               <!-- <div class="card-body">
                    <h2>Area sizes</h2>
                    <p>Total area: <%= (project.layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
                    <p>Total tree row strip area (Approximation): <%= treeArea.toFixed(0) %> m2</p>
                    <p>Headland and margin: <%= marginArea.toFixed(0) %> m2</p>
                    <p>Rest (Approximation): <%= project.layer.size.toFixed(0) - treeArea.toFixed(0) - marginArea.toFixed(0) %> m2</p>
                </div>-->
            <% } %>
            <h2>Tree and shrub counts</h2>
            <div class="card">
                <div class="card-body">
                    <% species.forEach(function(species){ %>
                    <p><%= species.id %> count: <%= species.uniqueCount %></p>
                    <% }); %>
                </div>
            </div>
        </div>
        <% if(project.rows && project.rows.length > 0){ %>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h2>Planned rows</h2>
                        <button class="btn mb-2 btn-outline-primary" type="button" data-toggle="collapse" data-target="#collapseRows" aria-expanded="false" aria-controls="collapseExample">
                            View rows
                        </button>
                        <div class="collapse" id="collapseRows">
                            <div class="card card-body">
                                <table class="table small">
                                    <tr class="table-secondary">
                                        <td>Row ref</td>
                                        <td>Row sequense pattern</td>
                                        <td></td>
                                    </tr>
                                    <% if(project.rows && project.rows.length > 0){ %>
                                    <% for(i=0;i<project.rows.length;i++){ %>
                                    <tr>
                                        <td><%= project.rows[i].name %></td>
                                        <% if(project.rows[i].sequence){ %>
                                        <td><%= project.rows[i].sequence.name %></td>
                                        <% } else { %>
                                        <td>---</td>
                                        <% } %>
                                        <td>
<!--
                                            <a href="/projects/<%= project._id %>/sequences/<%= project.rows[i].sequence._id %>/edit" class="btn btn-sm btn-outline-warning"><i class="far fa-edit"></i></a>
-->
                                            <a href="/projects/<%= project._id %>/row/edit?index=<%= i %>" class="btn btn-sm btn-outline-warning"><i class="far fa-edit"></i></a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-toggle="modal" data-target="#myModalDeleteRow<%= i %>"><i class="far fa-trash-alt"></i></button>
                                        </td>
                                    </tr>
                                    <!-- Modal -->
                                    <div class="modal fade" id="myModalDeleteRow<%= i %>" role="dialog">
                                        <div class="modal-dialog">
                                            <!-- Modal content-->
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                    <h4 class="modal-title">Confirm deletion of row</h4>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Confirm deletion of row: "<%= project.rows[i].name %>"</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <form class="delete-form" action="/projects/<%= project._id %>/row?_method=DELETE&index=<%= i %>" method="POST">
                                                        <button class="btn btn-sm btn-outline-danger">Delete row <i class="far fa-trash-alt"></i></button>
                                                    </form>
                                                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                                    <% } %>
                                </table>
                                <button type="button" class="btn btn-sm btn-outline-danger" data-toggle="modal" data-target="#myModalDeleteAllRows">Delete all rows <i class="far fa-trash-alt"></i></button>
                                <!-- Modal -->
                                <div class="modal fade" id="myModalDeleteAllRows" role="dialog">
                                    <div class="modal-dialog">
                                        <!-- Modal content-->
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                                                <h4 class="modal-title">Confirm delete all rows</h4>
                                            </div>
                                            <div class="modal-body">
                                                <p>Reverts the design and planning back to dynamic design where you can change headland and overall system design again. This will delete all current individual rows, areas and assets on the project. This will not delete any existing rows, areas or trees on your area, only on the project.</p>
                                            </div>
                                            <div class="modal-footer">
                                                <a href="/projects/<%= project._id %>/deleterows" class="btn mt-2 mb-2 btn-outline-danger">Delete all rows</a>
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="col-md-3">
                <h2>System model</h2>
                <p><i><%= project.system.name %></i></p>
                <p>Total system width: <%= rowWidth %> m</p>
                <p>Total area: <%= (project.layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5>Change parameters</h5>
                        <form action="/projects/<%= project._id %>/layout?_method=PUT" method="POST">
                            <div class="form-group">
                                <label for="project[layout]">Layout type</label>
                                <select class="form-control" name="project[layout]">
                                    <% if(project.layout === "straight") { %>
                                    <option selected="selected" value="straight">Straight rows</option>
                                    <% } else { %>
                                    <option value="straight">Straight rows</option>
                                    <% } %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="project[alignment]">Alignment</label>
                                <select class="form-control" name="project[alignment]">
                                    <% if(project.alignment === "bearing") { %>
                                    <option selected="selected" value="bearing">Angled rows</option>
                                    <% } else { %>
                                    <% if(project.alignment === "north") { %>
                                    <option selected="selected" value="north">North/south</option>
                                    <% } else { %>
                                    <option value="north">North/south</option>
                                    <% } %>
                                    <% if(project.alignment === "west") { %>
                                    <option selected="selected" value="west">West/East</option>
                                    <% } else { %>
                                    <option value="west">West/East</option>
                                    <% } %>
                                    <% } %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="project[headland]">Headland</label>
                                <input type="number" min="0" max="<%= rowWidth %>" class="form-control" name="project[headland]" value="<%= project.headland %>">
                            </div>
                            <div class="btn-group">
                                <button type="submit" class="btn btn-outline-primary"><i class="fas fa-sync-alt"></i> Update parameters</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>


    </div>

<script>
    var areaLat = "<%= project.layer.lat %>";
    var areaLng = "<%= project.layer.lng %>";

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var alleys = "<%= alleys %>";
    var correctalleys = JSON.parse(alleys.replace(/&#34;/g,'"'));

    var col = "<%= collection %>";
    var correctcol = JSON.parse(col.replace(/&#34;/g,'"'));

    var getgeometry = "<%= project.layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 15,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#7F22C0',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });
/*
        map.addLayer({
            'id': 'alleys',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctalleys
            },
            'layout': {},
            'paint': {
                'fill-color': '#002eff'
            }
        });*/

        map.addLayer({
            'id': 'map1',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data':
                    correctcol
            },
            'layout': {},
            'paint': {
                'line-color': '#fff1ff',
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#5cb85c'
            }
        });

    });

</script>

<% include ../partials/footer %>