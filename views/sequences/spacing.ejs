<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8">
        <h1>Define grid for your new row sequence</h1>
        <% if(project){ %>
            <form action="/projects/<%= project._id %>/sequences/spacing" method="POST">
        <% } else { %>
            <form action="/layers/<%= layer._id %>/sequences/spacing" method="POST">
        <% } %>
            <div class="form-group">
                <label for="distance">Minimum distance between species in row sequence [m] (Lowest denominator)</label>
                <input type="number" step=".1" class="form-control" name="distance" placeholder="Distance in m" required>
            </div>
            <div class="form-group">
                <label for="length">Length of row sequence [m]</label>
                <input type="number" step=".1" class="form-control" name="length" placeholder="Length in m" required>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg mt-3">Create row sequence</button>
            </div>
        </form>
    </div>
    <div class="col-lg-2"></div>
</div>

<% include ../partials/footer %>