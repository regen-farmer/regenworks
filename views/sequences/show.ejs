<% include ../partials/header %>
<% include ../partials/navbar %>

<h1>Sequence: <%= sequence.name %></h1>
<div class="row">
    <div class="col-sm-6">
        <h2>Sequence layout</h2>
        <svg viewBox="0 0 <%= systemwidth + 2 %> <%= systemlength + 2 %>">
            <% if(rows){ %>
            <% var width = 0 %>
            <% for(i=0;i<rows.length;i++){ %>
            <% if(i < 1){ %>
            <% width = rows[i].array[0].width/2 %>
            <% } else { %>
            <% width = width + rows[i].array[0].width/2 + rows[i-1].array[0].width/2 %>
            <text x="<%= width - (rows[i].array[0].width/2 + rows[i-1].array[0].width/2)/2 + 1 %>" y="0.5" class="smallspeciesname">-- <%= rows[i].array[0].width/2 + rows[i-1].array[0].width/2 %> --</text>
            <% } %>
            <line x1="<%= width + 1 %>" y1="1" x2="<%= width + 1 %>" y2="<%= systemlength + 1 %>" style="stroke:rgb(150,150,150);stroke-width:0.02"/>

            <% for(j=0;j<rows[i].array.length;j++){ %>
            <% if(!(rows[i].array[j].species.form === "grass" || rows[i].array[j].species.form === "herb")){ %>

            <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="<%= width %>px" y="<%= systemlength - (rows[i].array[j].position[1])%>px"
                 width="2px" height="2px" viewBox="89 89 2 2" enable-background="new 89 89 2 2" xml:space="preserve">
                <% if(rows[i].array[j].species.form === "palm"){ %>
                <% include ../graphics/palmtop %>
                <% } else if(rows[i].array[j].species.form === "giantherb"){ %>
                <% include ../graphics/giantherbtop %>
                <% } else if(rows[i].array[j].species.form === "succulent"){ %>
                <% include ../graphics/succulenttop %>
                <% } else if(rows[i].array[j].species.form === "tree"){ %>
                <% include ../graphics/treetop %>
                <% } else if(rows[i].array[j].species.form === "shrub"){ %>
                <% include ../graphics/shrubtop %>
                <% } else { %>
                <% include ../graphics/treetop %>
                <% } %>
            </svg>
            <text x="<%= width + 1 %>" y="<%= systemlength - (rows[i].array[j].position[1] - 2)%>" class="smallspeciesname"><%= rows[i].array[j].species.nameCommon %></text>
            <% } %>
            <% } %>
            <% }; %>
            <% } %>
            <style>
                /*
                                    circle { fill: #6EBC4A; }
                */
                .smallspeciesname { font: 0.2px sans-serif; font-family: 'Open Sans', sans-serif; text-anchor: middle; }
            </style>
        </svg>
    </div>
</div>

<% include ../partials/footer %>