<% include ../partials/header %>
<% include ../partials/navbar %>
<div class="container">
    <h1>Your parcels of land</h1>
    <p>Explore your parcels of land or create a new one.</p>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% parcels.forEach(function(parcel){ %>
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img class="img-responsive" src="/images/parcel.svg">
                    <div class="caption">
                        <h4> <%= parcel.name %> </h4>
                        <p><%= parcel.size %> Acres</p>
                        <p>
                            <a href="/parcels/<%= parcel._id %>" class="btn btn-success">More info</a>
                        </p>
                    </div>
                </div>
            </div>
        <% }); %>
        <a href="/parcels/new">
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail" align="center">
                    <i class="fas fa-plus fa-8x"></i>
                    <div class="caption text-center">
                        <h4>Add new parcel</h4>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<% include ../partials/footer %>