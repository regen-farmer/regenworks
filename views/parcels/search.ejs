<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div>
                <h1>Steder nær dig</h1>
                <p>Økologiske fødevarefællesskaber, gårdbutikker, markeder m.m. nær dig.</p>
                <h2>Viser resultater for "<%= searchterm %>"</h2>
            </div>
        </div>
    </div>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% places.slice(0,12).forEach(function(places){ %>
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img class="img-responsive" src="<%= places.image %>">
                    <div class="caption">
                        <p class="pull-right"><%= places.distance %>  km</p>
                        <p class="type"> <%= places.type %> </p>
                        <h4> <%= places.name %> </h4>
                        <p>
                            <a href="/places/<%= places._id %>" class="btn btn-success">Mere Info</a>
                        </p>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
    <h2>Søg igen</h2>
    <p>Søg efter et andet sted.</p>
    <form action="/places/search" method="POST">
        <div class="input-group">
            <input class="form-control" type="text" name="location" placeholder="Skriv adresse, by eller postnummer" required>
            <span class="input-group-btn">
                <button type="submit" class="btn btn-success"><i class="fas fa-search"></i> Søg!</button>
            </span>
        </div>
    </form>
    <br>
</div>

<% include ../partials/footer %>