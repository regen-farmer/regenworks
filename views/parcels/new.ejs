<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h2>Add Parcel</h2>
            <div>
                <form action="/parcels" method="POST">
                    <p>Add a new parcel of land to your collection.</p>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Name</label>
                        <input type="text" class="form-control" name="parcel[name]" placeholder="Give your parcel a name" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Address/location</label>
                        <input type="text" class="form-control" name="parcel[location]" placeholder="Add the address of the parcel" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Description (Optional)</label>
                        <input type="text" class="form-control" name="parcel[description]" placeholder="Give the parcel a description">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Parcel size (Hectares)</label>
                        <input type="number" class="form-control" name="parcel[size]" placeholder="How big is this parcel?">
                    </div>
                    <div class="form-group btn-group btn-group-toggle" data-toggle="buttons">
                        <label for="formGroupExampleInput">Soil type</label>
                        <br>
                        <label class="btn btn-default">
                            <input type="radio" name="parcel[soilType]" value="sand" autocomplete="off" required> Sand
                        </label>
                        <label class="btn btn-default">
                            <input type="radio" name="parcel[soilType]" value="loam" autocomplete="off"> Loam
                        </label>
                        <label class="btn btn-default">
                            <input type="radio" name="parcel[soilType]" value="clay" autocomplete="off"> Clay
                        </label>
                    </div>
                    <br>
                    <div class="form-group btn-group btn-group-toggle" data-toggle="buttons">
                        <label for="formGroupExampleInput">Farming type</label>
                        <p>Choose all that apply</p>
                        <label class="btn btn-default">
                            <input type="checkbox" name="parcel[agType]" value="Crop Cultivation" autocomplete="off"> Crop Cultivation
                        </label>
                        <label class="btn btn-default">
                            <input type="checkbox" name="parcel[agType]" value="Animal husbandry" autocomplete="off"> Animal husbandry
                        </label>
                        <label class="btn btn-default">
                            <input type="checkbox" name="parcel[agType]" value="Forestry" autocomplete="off"> Forestry
                        </label>
                        <label class="btn btn-default">
                            <input type="checkbox" name="parcel[agType]" value="Orchard" autocomplete="off"> Orchard
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Practices</label>
                        <p>Please choose the key practices/methods currently used on this parcel.</p>
                        <div class="row">
                            <% practices.forEach(function(practice){ %>
                            <div class="col-lg-3">
                                <div data-toggle="buttons">
                                    <label class="btn btn-default btn-block">
                                        <input type="checkbox" autocomplete="off" name="practiceids" value="<%= practice._id %>"><p><%= practice.name %></p>
                                    </label>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <div>
                        <p><strong>Parcel geometry</strong></p>
                        <p>Please zoom in and draw the outside perimeter of your parcel of land by clicking on the "draw a polygon" button on the map below. Press "Finish" to close the shape.</p>
                    </div>
                    <div id="parcelMapNew"></div>
                    <hr>
                    <input type="hidden" id="geometry" name="geometry">
                    <div id="coordinates"></div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-lg center-block">Create parcel</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-2"></div>
    </div>
</div>

<script>
    // NEW LAYER GEOMETRY MAP
    var myparcelmapnew = L.map('parcelMapNew').setView([0, 0], 1);

    L.tileLayer('https://api.tiles.mapbox.com/v4/{id}/{z}/{x}/{y}.png?access_token={accessToken}', {
        attribution: 'Map data &copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors, <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC-BY-SA</a>, Imagery © <a href="https://www.mapbox.com/">Mapbox</a>',
        maxZoom: 18,
        id: 'mapbox.outdoors',
        accessToken: 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA'
    }).addTo(myparcelmapnew);

    // FeatureGroup is to store editable layers
    var editableLayers = new L.FeatureGroup();
    myparcelmapnew.addLayer(editableLayers);

    var drawPluginOptions = {
        position: 'topright',
        draw: {

            // disable toolbar item by setting it to false
            polyline: false,
            circle: false, // Turns off this drawing tool
            rectangle: false,
            marker: false,
        },
        edit: {
            featureGroup: editableLayers, //REQUIRED!!
            remove: false
        }
    };

    // Initialise the draw control and pass it the FeatureGroup of editable layers
    var drawControl = new L.Control.Draw(drawPluginOptions);
    myparcelmapnew.addControl(drawControl);

    myparcelmapnew.on('draw:created', function(e) {
        var type = e.layerType,
            layer = e.layer;

        if (type === 'marker') {
            layer.bindPopup('A popup!');
        }

        var shape = layer.toGeoJSON();
        var shape_for_db = JSON.stringify(shape);

        // Try and send to HTML
        alert('A parcel geometry has successfully been created and you may click the "Create parcel" button below.');
        // document.getElementById("coordinates").innerHTML = "A parcel geometry has successfully been created and you may click the button below to create the new parcel";
        document.getElementById("geometry").value = shape_for_db;

        editableLayers.addLayer(layer);
    });
</script>

<% include ../partials/footer %>