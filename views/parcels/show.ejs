<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div id='map' style='width: 550px; height: 550px;'></div>
        </div>
        <div class="col-md-6">
            <h1>Farm: <%= parcel.name %></h1>
            <p><%= parcel.description %></p>
            <h2>Farm areas</h2>
            <p>Farm areas is a simple way to organize the different activities on your farm into specific zones and areas. </p>
            <div class="row">
                <% parcel.layers.forEach (function(layer){ %>
                <div class="col-md-12">
                    <a href="/layers/<%= layer._id %>" class="btn btn-outline-secondary btn-block mb-1">
                        Explore production systems for area "<%= layer.name %>"
                    </a>
                </div>
                <% }); %>
                <div class="col-md-12">
                    <a href="/parcels/<%= parcel._id %>/layers/new" class="btn btn-success btn-block">
                        Add new area to this farm
                    </a>
                </div>
            </div>
            <h2>Farm details</h2>
            <p><i class="fas fa-map-marker"></i> <%= parcel.location %></p>
            <p><strong>Farm size:</strong> <%= parcel.size %> hectare(s)</p>
            <p><strong>Soil type:</strong> <%= parcel.soilType %></p>
            <% if(currentUser && parcel.owner.id.equals(currentUser._id)){ %>
            <a class="btn btn-outline-primary" href="/parcels/<%= parcel._id %>/edit">Edit farm details</a>
            <form class="delete-form" action="/parcels/<%= parcel._id %>?_method=DELETE" method="POST">
                <button class="btn btn-outline-danger">Delete farm</button>
            </form>
            <% } %>
        </div>
        <div class="col-md-12">
        </div>
        <div class="col-md-8">
            <div>
                <!--
                <% if (parcel.practices){ %>
                <h2>Practices used on this farm</h2>
                <p>Below is a list of key practices used on this farm. Please keep this up-to-date to ensure the best regenerative assessment. You can add and remove practices by clicking the "Edit parcel details" button.</p>
                <div class="row">
                    <% parcel.practices.forEach(function(practice){ %>
                    <div class="col-xs-6 col-sm-3">
                        <div class="well well-sm">
                            <p><%= practice.name %></p>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } %>
                -->
            </div>
        </div>
    </div>
</div>

<script>
    var parcelLat = "<%= parcel.lat %>";
    var parcelLng = "<%= parcel.lng %>";

    var getcollection = "<%= collection %>";
    var correctcollection = JSON.parse(getcollection.replace(/&#34;/g,'"'));



mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [parcelLng, parcelLat],
        zoom: 14,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': correctcollection
            },
            'layout': {},
            'paint': {
                'fill-color': '#7F22C0',
                'fill-opacity': 0.6
            }
        });
    });
</script>

<% include ../partials/footer %>