<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div id='map' style='width: 550px; height: 550px;'></div>
        </div>
        <div class="col-md-6">
            <h1>Farm: <%= parcel.name %></h1>
            <p><%= parcel.description %></p>
            <h2>Farm areas</h2>
            <p>Farm areas is a simple way to organize the different activities on your farm into specific zones and areas. </p>
            <div class="row">
                <% parcel.layers.forEach (function(layer){ %>
                <div class="col-md-12">
                    <a href="/layers/<%= layer._id %>" class="btn btn-default btn-block">
                        <p>Explore production systems for "<%= layer.name %>"</p>
                    </a>
                </div>
                <% }); %>
                <div class="col-md-12">
                    <a href="/parcels/<%= parcel._id %>/layers/new" class="btn btn-success btn-block">
                        <p>Add new area to this farm</p>
                    </a>
                </div>
            </div>
            <h2>Farm details</h2>
            <p><i class="fas fa-map-marker"></i> <%= parcel.location %></p>
            <p><strong>Farm size:</strong> <%= parcel.size %> hectare(s)</p>
            <p><strong>Soil type:</strong> <%= parcel.soilType %></p>
            <% if(currentUser && parcel.owner.id.equals(currentUser._id)){ %>
            <a class="btn btn-default" href="/parcels/<%= parcel._id %>/edit">Edit parcel details</a>
            <form class="delete-form" action="/parcels/<%= parcel._id %>?_method=DELETE" method="POST">
                <button class="btn btn-danger">Delete parcel</button>
            </form>
            <% } %>
        </div>

        <div class="col-md-12">

        </div>
        <div class="col-md-8">
            <div>
                <!--
                <% if (parcel.practices){ %>
