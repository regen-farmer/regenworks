<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <div>
                <h1>Parcel: <%= parcel.name %></h1>
                <p><%= parcel.description %></p>
                <hr>
                <% if(!(parcel.projects == "")){ %>
                    <h2>Oplevelser og arrangementer hos <%= parcel.name %></h2>
                    <% parcel.projects.forEach (function(project){ %>
                        <div class="col-md-6 col-sm-6">
                            <div class="thumbnail">
                                <div class="caption">
                                    <h4> <%= project.name %> </h4>
                                    <p>Dato: <%= project.start.date %> kl. <%= project.start.time %></p>
                                    <a href="/experiences/<%= project._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                                    <% if(!(project.price === "")){ %>
                                        <p> <%= project.price %> kr. pr. person </p>
                                    <% } else { %>
                                        <p> gratis </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
                <h2>Parcel areas</h2>
                <p>Parcel areas is a simple way to organize the different activities on your farm into specific zones and areas. </p>
                <div class="row">
                    <% parcel.layers.forEach (function(layer){ %>
                        <div class="col-md-12">
                            <a href="/layers/<%= layer._id %>" class="btn btn-default btn-block">
                                <p>"<%= layer.name %>" Area Type: "<%= layer.type %>"</p>
                            </a>
                        </div>
                    <% }); %>
                    <div class="col-md-12">
                        <a href="/parcels/<%= parcel._id %>/layers/new" class="btn btn-success btn-block">
                            <p>Add new area to this parcel</p>
                        </a>
                    </div>
                </div>
                <!--
                <h2>Parcel regen scores <i class="fa fa-info-circle" data-toggle="tooltip" title="These scores are generated based on your unique parcel profile and expert analysis based on leading scientific studies within agroecology."></i></h2>
                <p>The regen score act as a baseline for the regenerative state of your land. We use the Regen Score in our regenerative assessment and for recommending new regenerative practices tailor made for your farm. </p>
