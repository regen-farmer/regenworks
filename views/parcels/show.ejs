                                <g class='bars'>
                                    <rect fill='#f6f6f6' width='100%' height='25'></rect>;
                                    <rect fill='#4cae4c' width='<%= soilScore*20 %>%' height='25'></rect>
                                </g>
                            </svg>
                            <p><%= soilScore %> / 5</p>
                        </div>
                    </div>
                    <div class="col-xs-6 col-sm-3">
