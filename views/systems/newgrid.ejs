<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8">
        <h1>Define grid for your new system</h1>
        <form action="/layers/<%= layer._id %>/systems/newgrid" method="POST">
            <div class="form-group">
                <label for="rows">Number of rows/alleys in system</label>
                <input type="number" class="form-control" max="12" name="rows" required>
            </div>
            <div class="form-group">
                <label for="distance">Minimum distance between species in any row (m)</label>
                <input type="number" step=".1" class="form-control" name="distance" placeholder="Distance in m" required>
            </div>
            <div class="form-group">
                <label for="length">Length of system (m)</label>
                <input type="number" step=".1" class="form-control" name="length" placeholder="Length in m" required>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg mt-3">Create system grid</button>
            </div>
        </form>
    </div>
    <div class="col-lg-2"></div>
</div>

<% include ../partials/footer %>