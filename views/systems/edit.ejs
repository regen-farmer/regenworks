<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-12">
            <h1>Update agroforestry system model "<%= system.name %>"</h1>
            <p>This page lets you update your agroforestry system model.</p>
            <form action="/systems/<%= system._id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="system[name]">System name</label>
                    <input type="text" class="form-control" name="system[name]" value="<%= system.name %>" required>
                </div>
                <div class="form-group">
                    <label for="system[description]">Description</label>
                    <input type="text" class="form-control" name="system[description]" value="<%= system.description %>">
                </div>
                <div class="form-group">
                    <label for="system[animals][0]">Animals in system (If any)</label>
                    <select name="system[animals][0]">
                        <option value="">none</option>
                        <% system.animals.forEach(function(animal){ %>
                        <option value="<%= animal._id %>" selected="selected"><%= animal.name %> (existing)</option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-check">
                    <% if(system.shared === true){ %>
                        <input type="checkbox" name="system[shared]" id="exampleRadios1" class="form-check-input" checked="checked" autocomplete="off">
                    <% } else { %>
                        <input type="checkbox" name="system[shared]" id="exampleRadios1" class="form-check-input" autocomplete="off">
                    <% } %>
                    <label class="form-check-label" for="exampleRadios1">
                        Share this system with other farmers
                    </label>
                </div>
                <h3>System model</h3>
                <div class="row">
                    <% var xPosition = 0; %>
                    <% var extentrows = 0; %>
                    <% if(newrow > -1){ %>
                        <% extentrows = 1; %>
                    <% } %>
                    <% if(newrow === 0){ %>
                        <div class="col-lg-<%= Math.floor(12/(rows.length + extentrows)) %>">
                            <h5>Row <%= 1 %></h5>
                            <div class="form-group">
                                <label for="system[model][<%= newrow %>][width]">Row width</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= newrow %>][width]" value="<%= 1 %>" required>
                            </div>
                            <div class="form-group">
                                <label for="system[model][<%= newrow %>][distance]">Distance to next row</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= newrow %>][distance]" value="<%= 1 %>" required>
                            </div>
                            <% for(i=0;i<(length/distance);i++){ %>
                                <div class="card">
                                    <div class="card-body">
                                        <select name="system[model][<%= newrow %>][species][id]" style="width:100%;max-width:100%;">
                                            <option value="">none</option>
                                            <% species.forEach(function(species){ %>
                                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                            <% }); %>
                                        </select>
                                        <input type="hidden" name="system[model][<%= newrow %>][species][y]" value="<%= length - i*distance %>">
                                        <p>Row position: <%= length - i*distance %> m</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                    <% for(j=0;j<rows.length;j++){ %>
                        <% var rowafter = 0; %>
                        <% if(j + 1 <= newrow || newrow === -1){ %>
                            <% rowafter = 0; %>
                        <% } else { %>
                            <% rowafter = 1; %>
                        <% } %>
                        <div class="col-lg-<%= Math.floor(12/(rows.length + extentrows)) %>">
                            <% if(j === 0){ %>
                                <% xPosition = rows[j].array[0].position[0]; %>
                            <% } else { %>
                                <% xPosition = rows[j].array[0].position[0] - rows[j-1].array[0].position[0] %>
                            <% } %>
                            <h5>Row <%= j + 1 + rowafter %></h5>
                            <div class="form-group">
                                <label for="system[model][<%= j + rowafter %>][width]">Row width</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= j + rowafter %>][width]" value="<%= rows[j].array[0].width %>" required>
                            </div>
                            <div class="form-group">
                                <label for="system[model][<%= j + rowafter %>][distance]">Distance to next row</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= j + rowafter %>][distance]" value="<%= xPosition + rowafter %>" required>
                            </div>
                            <% for(i=0;i<(length/distance);i++){ %>
                                <div class="card">
                                    <div class="card-body">
                                        <select name="system[model][<%= j + rowafter %>][species][id]" style="width:100%;max-width:100%;">
                                            <option value="">none</option>
                                            <% species.forEach(function(species){ %>
                                                <% var count = 0; %>
                                                <% for(k=0;k<rows[j].array.length;k++){ %>
                                                    <% if(rows[j].array[k].position[1] === length - i*distance && rows[j].array[k].species.nameCommon === species.nameCommon){ %>
                                                        <option value="<%= species._id %>" selected="selected"><%= species.nameCommon %></option>
                                                        <% count = 1; %>
                                                    <% } %>
                                                <% } %>
                                                <% if(count === 0){ %>
                                                    <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                                <% } %>
                                            <% }); %>
                                        </select>
                                        <input type="hidden" name="system[model][<%= j + rowafter %>][species][y]" value="<%= length - i*distance %>">
                                        <p>Row position: <%= length - i*distance %> m</p>
                                    </div>
                                </div>
                            <% } %>
                            <% if(newrow < 0){ %>
                                <% if(j === 0){ %>
                                    <a class="btn btn-outline-primary" href="/systems/<%= system._id %>/edit?row=0"><-- new row</a>
                                <% } %>
                                <a class="btn btn-outline-primary" href="/systems/<%= system._id %>/edit?row=<%= j + 1 %>">new row --></a>
                            <% } %>
                        </div>
                        <% if(j + 1 === newrow){ %>
                            <div class="col-lg-<%= Math.floor(12/(rows.length + extentrows)) %>">
                                <h5>Row <%= newrow + 1 %></h5>
                                <div class="form-group">
                                    <label for="system[model][<%= newrow %>][width]">Row width</label>
                                    <input type="number" step=".01" class="form-control" name="system[model][<%= newrow %>][width]" value="<%= 1 %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="system[model][<%= newrow %>][distance]">Distance to next row</label>
                                    <input type="number" step=".01" class="form-control" name="system[model][<%= newrow %>][distance]" value="<%= 1 %>" required>
                                </div>
                                <% for(i=0;i<(length/distance);i++){ %>
                                    <div class="card">
                                        <div class="card-body">
                                            <select name="system[model][<%= newrow %>][species][id]" style="width:100%;max-width:100%;">
                                                <option value="">none</option>
                                                <% species.forEach(function(species){ %>
                                                    <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                                <% }); %>
                                            </select>
                                            <input type="hidden" name="system[model][<%= newrow %>][species][y]" value="<%= length - i*distance %>">
                                            <p>Row position: <%= length - i*distance %> m</p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        <% } %>
                    <% } %>
                </div>
                <% if(distance >= 1 && Number.isInteger(distance)){ %>
                    <div class="card">
                        <div class="card-body">
                            <a class="btn btn-outline-primary" href="/systems/<%= system._id %>/edit?distance=2">Change inter-row spacing to <%= distance/2 %></a>
                        </div>
                    </div>
                <% } %>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg mt-3">Update system</button>
                </div>
            </form>
        </div>
    </div>

<% include ../partials/footer %>