<% include ../partials/header %>
<% include ../partials/navbar %>

<h1>System comparison</h1>
<p>Comparison of future system drafts for area "<%= layer.name %>". </p>
<% systems.forEach(function(system){ %>
    <div class="card text-center">
        <div class="row">
            <div class="col-md-3">
                <div class="row p-3 justify-content-center">
                    <% system.rows.forEach(function(row){ %>
                        <div class="col-sm-3">
                            <img class="img-fluid" src="/images/<%= row.sequense[0].form %>.svg">
                        </div>
                    <% }); %>
                </div>
                <div class="card-body">
                    <h5 class="card-title"><%= system.name %></h5>
                    <p>Specs: Species, utility, grid size</p>

                </div>
            </div>
            <div class="col-md-9">
                <div class="row">
                    <div class="col-md-3 card-body">
                        <p>Productivity and profit</p>
                    </div>
                    <div class="col-md-3 card-body">
                        <p>Resilience and food security</p>
                    </div>
                    <div class="col-md-3 card-body">
                        <p>Biomass and sequestration</p>
                    </div>
                    <div class="col-md-3 card-body">
                        <p>Labor and workflows</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
<% }); %>

<% include ../partials/footer %>