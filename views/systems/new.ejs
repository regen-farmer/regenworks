<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h1>Create new agroforestry system model for area "<%= layer.name %>"</h1>
            <p>This page lets you create a new agroforestry system model.</p>
            <form action="/layers/<%= layer._id %>/systems" method="POST">
                <div class="form-group">
                    <label for="system[name]">System name</label>
                    <input type="text" class="form-control" name="system[name]" placeholder="Give the system a name - Descriptive is often best" required>
                </div>
                <div class="form-group">
                    <label for="system[description]">Description</label>
                    <input type="text" class="form-control" name="system[description]" placeholder="Describe what is on the system: apple orchard, cereal crops, grazing area, etc.">
                </div>
                <div class="form-group">
                    <label for="system[rows]">System row species</label>
                    <div class="row">
                        <div class="col-lg-12">
                            <p>Row 1 sequence</p>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][0][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                    <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][0][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][0][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][0][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <input type="number" step=".01" class="form-control" name="system[rows][0][width]" placeholder="Row 1 width in m">
                        <hr>
                        <div class="col-lg-12">
                            <p>Row 2 sequence</p>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][1][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][1][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][1][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][1][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <input type="number" step=".01" class="form-control" name="system[rows][1][width]" placeholder="Row 2 width in m">
                        <hr>
                        <div class="col-lg-12">
                            <p>Row 3 sequence</p>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][2][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][2][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][2][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][2][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <input type="number" step=".01" class="form-control" name="system[rows][2][width]" placeholder="Row 3 width in m">
                        <hr>
                        <div class="col-lg-12">
                            <p>Row 4 sequence</p>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][3][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][3][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][3][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-lg-3">
                            <select name="system[rows][3][sequense]">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                <% }); %>
                            </select>
                        </div>
                        <input type="number" step=".01" class="form-control" name="system[rows][3][width]" placeholder="Row 4 width in m">
                    </div>
                </div>
                <div class="form-group">
                    <label for="system[animals][0]">Animals in system (If any)</label>
                    <select name="system[animals][0]">
                        <option value="">none</option>
                        <% animals.forEach(function(animal){ %>
                        <option value="<%= animal._id %>"><%= animal.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="system[shared]" id="exampleRadios1">
                    <label class="form-check-label" for="exampleRadios1">
                        Share this system with other farmers
                    </label>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg mt-3">Create new system</button>
                </div>
            </form>
        </div>
        <div class="col-lg-2"></div>
    </div>
</div>

<% include ../partials/footer %>