<% include ./partials/header %>
<% include ./partials/navbar %>

<div class="container">
    <h1>Farm area system species composition</h1>
    <% if(!(layers == "")){ %>
    <p>Select a system and optimize its species composition.</p>
    <div class="row">
        <% layers.forEach(function(layer){ %>
        <div class="col-lg-3">
            <div class="thumbnail">
                <div class="caption">
                        <h2>Systems on area "<%= layer.name %>"</h2>
                    <% layer.systems.future.forEach(function(system){ %>
                    <hr>
                        <p><%= system.name %></p>
                        <a class="btn btn-success" href="/systems/<%= system._id %>/composition">Explore species composition</a>

                    <% }); %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
    <% } else { %>
    <p>There currently is no future systems defined on any of your areas.</p>
    <% } %>
</div>

<% include ./partials/footer %>