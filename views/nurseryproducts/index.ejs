<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1>Cultivars</h1>
    <p>Count: <%= products.length %></p>
    <table class="table table-striped">
        <tr>
            <td>Name</td>
            <td>Variety</td>
            <td>Species</td>
            <td>User</td>
            <td></td>
        </tr>
        <% products.forEach(function(product){ %>
        <tr>
            <td><%= product.name %></td>
            <td><%= product.variety %></td>
            <td><%= product.species.nameCommon %></td>
            <td><%= product.owner.username %></td>
            <td><a href="/nurseryproduct/<%= product._id %>" class="btn btn-success">Show more</a></td>
        </tr>
        <% }); %>
    </table>
</div>

<% include ../partials/footer %>