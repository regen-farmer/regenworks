<% include ../partials/header %>
<% include ../partials/nurserynav %>

<div class="row">

    <div class="col-lg-3"></div>

    <div class="col-lg-6">
        <h2>Create new product</h2>
        <div>
            <form action="/nurseries/<%= nursery._id %>/nurseryproducts" method="POST">
                <div class="form-group">
                    <label for="product[name]">Name</label>
                    <input type="text" class="form-control" name="product[name]" required>
                </div>
                <div class="form-group">
                    <label for="product[description]">Description</label>
                    <input type="text" class="form-control" name="product[description]" >
                </div>
                <div class="form-group">
                    <label for="product[price]">Price (In <%= nursery.currency %>)</label>
                    <input type="number" class="form-control" name="product[price]" required>
                </div>
                <div class="form-group">
                    <label for="product[stock]">Stock</label>
                    <input type="number" class="form-control" name="product[stock]" >
                </div>
                <div class="form-group">
                    <label for="product[orderlimit]">Max order limit</label>
                    <input type="number" class="form-control" name="product[orderlimit]" >
                </div>
                <div class="form-group">
                    <label for="product[class]">Classification</label>
                    <select class="form-control" name="product[class]">
                        <option value="nut">Nut</option>
                        <option value="fruit">Fruit</option>
                        <option value="woodland">Woodland</option>
                        <option value="ornamental">Ornamental</option>
                        <option value="vegetable">Vegetable</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="product[species]">Species (<em>botanical</em>)</label>
                    <select name="product[species]" style="width:100%;max-width:100%;" >
                        <option value="">none</option>
                        <% species.forEach(function(species){ %>
                            <option value="<%= species._id %>"><%= species.genus %> <%= species.species %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="product[variety]">Variety/Cultivar name</label>
                    <input type="text" class="form-control" name="product[variety]">
                </div>
                <div class="form-group">
                    <label for="product[rootstock]">Rootstock (Optional. Only select if grafted)</label>
                    <select name="product[rootstock]" style="width:100%;max-width:100%;">
                        <option value="">none</option>
                        <% species.forEach(function(species){ %>
                        <option value="<%= species._id %>"><%= species.genus %> <%= species.species %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="product[hybrid]">Hybrid (Optional. Only select if hybrid variety)</label>
                    <select name="product[hybrid]" style="width:100%;max-width:100%;">
                        <option value="">none</option>
                        <% species.forEach(function(species){ %>
                        <option value="<%= species._id %>"><%= species.genus %> <%= species.species %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg">Create Product</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-6"></div>
</div>


<% include ../partials/footer %>