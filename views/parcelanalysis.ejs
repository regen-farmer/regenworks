<% include ./partials/header %>
<% include ./partials/navbar %>

<div class="container">
    <h1>Farm area analysis</h1>
    <p>Assess suitable agroforestry systems for individual areas on the farm.</p>
    <% if(!(parcel.layers == "")){ %>
    <div class="row">
        <% parcel.layers.forEach(function(layer){ %>
        <div class="col-lg-3">
            <div class="thumbnail">
                <div class="caption">
                    <h2>Area: "<%= layer.name %>"</h2>
                    <a class="btn btn-success" href="/layers/<%= layer._id %>/analysis">Assess this area</a>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
    <% } else { %>
    <p>There currently is no defined areas for this farm/project. Create an area to do an assessment and get started with the planning.</p>
    <% } %>
</div>

<% include ./partials/footer %>