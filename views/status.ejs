<% include partials/header %>
<% include partials/navbar %>

<div class="row">
    <div class="col-md-12">
        <h2>Tests <em>by field</em></h2>
    </div>
    <div class="col-md-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <% parcel.layers.forEach(function(layer, i){ %>
                <% if(i === 0){ %>
                <li class="nav-item">
                    <a class="nav-link active" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="true"><%= layer.name %></a>
                </li>
                <% } else { %>
                <li class="nav-item">
                    <a class="nav-link" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="false"><%= layer.name %></a>
                </li>
                <% } %>
            <% }); %>

        </ul>
        <div class="tab-content" id="myTabContent">
            <% parcel.layers.forEach(function(layer, i){ %>
                <% if(i === 0){ %>
                    <div class="tab-pane fade show active" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                <% } else { %>
                    <div class="tab-pane fade" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                <% } %>
                        <div class="card">

                            <div class="card-body">
                                <h2>Soil tests</h2>
                                <a class="btn btn-outline-primary" href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/soiltests/new">Add soiltest <i class="fas fa-plus"></i></a>
                                <table class="table small">
                                    <tr class="table-secondary">
                                        <td>Ref</td>
                                        <td>Notes</td>
                                        <td>SOC</td>
                                    </tr>
                                    <% if(layer.soiltests && layer.soiltests.length > 0){ %>
                                    <% for(j=0;j<layer.soiltests.length;j++){ %>
                                    <tr>
                                        <td><%= layer.soiltests[j].name %></td>
                                        <% if(layer.soiltests[j].sequence){ %>
                                        <td>---</td>
                                        <% } else { %>
                                        <td>---</td>
                                        <% } %>
                                        <td>
                                            <a href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/soiltests/<%= layer.soiltests[j].name %>/edit" class="btn btn-sm btn-outline-warning">Edit soiltest<i class="fas fa-trash"></i></a>
                                        </td>
                                    </tr>
                                    <% } %>
                                    <% } %>
                                </table>
                            </div>
                            <div class="card-body">
                                <h2>Plant sap tests</h2>
                                <a class="btn btn-outline-primary" href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/saptests/new">Add saptest <i class="fas fa-plus"></i></a>
                                <table class="table small">
                                    <tr class="table-secondary">
                                        <td>Ref</td>
                                        <td>Notes</td>
                                        <td>pH</td>
                                    </tr>
                                    <% if(layer.saptests && layer.saptests.length > 0){ %>
                                    <% for(j=0;j<layer.saptests.length;j++){ %>
                                    <tr>
                                        <td><%= layer.saptests[j].name %></td>
                                        <% if(layer.saptests[j].sequence){ %>
                                        <td>---</td>
                                        <% } else { %>
                                        <td>---</td>
                                        <% } %>
                                        <td>
                                            <a href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/saptests/<%= layer.saptests[j].name %>/edit" class="btn btn-sm btn-outline-warning">Edit saptest<i class="fas fa-trash"></i></a>
                                        </td>
                                    </tr>
                                    <% } %>
                                    <% } %>
                                </table>
                            </div>
                        </div>

                    </div>
            <% }); %>
        </div>
    </div>
</div>

<% include partials/footer %>