<% include ../partials/header %>
<% include ../partials/nurserynav %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h1>Nursery</h1>
        <% if(nurseries){ %>
            <% nurseries.forEach(function(nursery){ %>
                <div class="card">
                    <div class="card-body">
                        <p><%= nursery.name %></p>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
    <div class="col-lg-3"></div>
</div>

<% include ../partials/footer %>