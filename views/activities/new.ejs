<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
        <h2>Add a new task</h2>
        <div>
            <form action="/activities" method="POST">
            <p>Add a new task to your calendar.</p>
            <div class="form-group">
                <label for="activity[name]">Task name</label>
                <input type="text" class="form-control" name="activity[name]" placeholder="Give the activity a name" required>
            </div>
            <div class="form-group">
                <label for="activity[start][date]">Date and time</label>
                <input type="date" class="form-control" name="activity[start][date]" placeholder="Set date" required>
                <input type="time" class="form-control" name="activity[start][time]" placeholder="Set time" required>
            </div>
            <div class="form-group">
                <label for="activity[layer]">Layer reference</label>
                <select class="form-control" name="activity[layer]">
                    <% layers.forEach (function(layer){ %>
                    <option value="<%= layer._id %>"><%= layer.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="btn-group">
                <button type="submit" class="btn btn-success btn-lg">Create task</button>
            </div>
            </form>
        </div>
        </div>
        <div class="col-lg-2"></div>
    </div>
</div>

<% include ../partials/footer %>