<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="col-md-6 col-sm-6">
        <div class="thumbnail">
            <div class="caption">
                <h3>Upcoming tasks</h3>
                <hr>
                <% if(activities === undefined){%>
                    <p>You do not have any upcoming tasks.</p>
                <% } else { %>
                    <div class="row">
                        <% activities.forEach(function(activity){ %>
                            <div class="col-md-12">
                                <a href="/activities/<%= activity._id %>" class="btn btn-default btn-block">
                                    <p>"<%= activity.name %>" Date: <%= activity.start.date %></p>
                                </a>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </div>
        <div class="thumbnail">
            <div class="caption">
                <h3>Overdue tasks</h3>
                <hr>
                <div class="row">
                    <div class="col-md-12">
                        <p>You do not have any overdue tasks.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="thumbnail">
            <div class="caption">
                <a href="/activities/new" class="btn btn-success pull-right">Add new task</a>
                <h3>Task calendar</h3>
                <hr>
                <div class="cal">
                    <div class="cal__header">
                        <button class="btn btn-action btn-link btn-lg" data-calendar-toggle="previous"><svg height="24" version="1.1" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"></path></svg></button>
                        <div class="cal__header__label" data-calendar-label="month">
                            March 2017
                        </div><button class="btn btn-action btn-link btn-lg" data-calendar-toggle="next"> <svg height="24" version="1.1" viewbox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z"></path></svg></button>
                    </div>
                    <div class="cal__week">
                        <span>Mon</span> <span>Tue</span><span>Wed</span> <span>Thu</span> <span>Fri</span> <span>Sat</span> <span>Sun</span>
                    </div>
                    <div class="cal__body" data-calendar-area="month"></div>
                </div>
                <hr>
                <p class="demo-picked text-center">
                    <strong>Showing tasks for selected date (grey)<span data-calendar-label="picked"></span></strong>
                </p>
                <div class="row">
                    <span data-calendar-label="tasks"></span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var activityArray = <%- JSON.stringify(activities) %>;

    // CALENDAR LOAD
    window.addEventListener('load', function () {
        vanillacalendar.init();
    });
</script>

<% include ../partials/footer %>