<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-md-12">
        <h2>Flows <em>by field</em></h2>
    </div>
    <div class="col-md-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <% parcel.layers.forEach(function(layer, i){ %>
            <% if(i === 0){ %>
            <li class="nav-item">
                <a class="nav-link active" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="true"><%= layer.name %></a>
            </li>
            <% } else { %>
            <li class="nav-item">
                <a class="nav-link" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="false"><%= layer.name %></a>
            </li>
            <% } %>
            <% }); %>
        </ul>
        <div class="tab-content" id="myTabContent">
            <% parcel.layers.forEach(function(layer, i){ %>
            <% if(i === 0){ %>
            <div class="tab-pane fade show active" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                <% } else { %>
                <div class="tab-pane fade" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                    <% } %>
                    <div class="card">

                        <div class="card-body">
                            <h2>Row/block flows</h2>
                            <table class="table small">
                                <tr class="table-secondary">
                                    <td>Row ref</td>
                                    <td>Row inputs</td>
                                    <td>Row outputs</td>
                                    <td></td>
                                </tr>
                                <% if(layer.rows && layer.rows.length > 0){ %>
                                <% for(i=0;i<layer.rows.length;i++){ %>
                                <tr>
                                    <td><%= layer.rows[i].name %></td>
                                    <td>---</td>
                                    <td>---</td>
                                    <td>
                                        <a href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/rows/<%= layer.rows[i]._id %>/farmflows/new" class="btn btn-sm btn-outline-primary">Add input/output <i class="fas fa-plus"></i></a>
                                        <a href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/rows/<%= layer.rows[i]._id %>/farmflows" class="btn btn-sm btn-outline-primary">view flows</a>
                                    </td>
                                </tr>
                                <% } %>
                                <% } %>
                            </table>
                        </div>
                        <!--<div class="card-body">
                            <h2>Sub-area flows</h2>
                        </div>-->
<!--
                        <a href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/farmflows/viz" class="btn btn-sm btn-outline-primary">View flow-map</a>
-->
                    </div>

                </div>
                <% }); %>
            </div>
        </div>
    </div>

<% include ../partials/footer %>