<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Tilføj sted</h2>
            <div>
                <form action="/places" method="POST">
                    <p>Her kan du tilføje et nyt sted til fællesskabet. </p>
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Gårdbutik" autocomplete="off" checked> Gårdbutik
                        </label>
                        <label class="btn btn-success active">
                            <input type="radio" name="place[type]" value="Fødevarefællesskab" autocomplete="off"> Fødevarefællesskab
                        </label>
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Vejbod" autocomplete="off"> Vejbod
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Navn</label>
                        <input type="text" class="form-control" name="place[name]" placeholder="Hvad hedder stedet?">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Billedelink</label>
                        <input class="form-control" type="text" name="place[image]" placeholder="image url">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Beskrivelse</label>
                        <input type="text" class="form-control" name="place[description]" placeholder="Giv stedet en beskrivelse.">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Adresse</label>
                        <input type="text" class="form-control" name="place[location]" placeholder="Giv stedet en addresse">
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-lg">Tilføj sted</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<% include ../partials/footer %>