<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Tilføj sted</h2>
            <div>
                <form action="/places" method="POST">
                    <p>Her kan du tilføje et nyt sted til fællesskabet.</p>
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Gårdbutik" autocomplete="off" required> Gårdbutik
                        </label>
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Fødevarefællesskab" autocomplete="off"> Fødevarefællesskab
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Navn</label>
                        <input type="text" class="form-control" name="place[name]" placeholder="Hvad hedder stedet?" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Billedelink</label>
                        <input class="form-control" type="text" name="place[image]" placeholder="Link til billede">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Beskrivelse</label>
                        <input type="text" class="form-control" name="place[description]" placeholder="Giv stedet en beskrivelse.">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Adresse</label>
                        <input type="text" class="form-control" name="place[location]" placeholder="Giv stedet en addresse" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Telefonnummer</label>
                        <input type="text" class="form-control" name="place[phone]" placeholder="Giv stedet et telefonnummer">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Kontakt email</label>
                        <input type="text" class="form-control" name="place[email]" placeholder="Giv stedet en kontaktemail">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Hjemmeside</label>
                        <input type="text" class="form-control" name="place[website]" placeholder="Giv stedet en hjemmeside">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Produkter</label>
                        <div class="row">
                            <% products.forEach(function(product){ %>
                            <div class="col-lg-3">
                                <div data-toggle="buttons">
                                    <label class="btn btn-default btn-block">
                                        <input type="checkbox" autocomplete="off" name="productids" value="<%= product._id %>"><p><%= product.name %></p>
                                    </label>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <p><em>"Ved at oprette dette sted bekræfter jeg at jeg er en officiel repræsentant for stedet"</em></p>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-success btn-lg">Tilføj sted</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<% include ../partials/footer %>