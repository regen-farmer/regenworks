<% include ../partials/header %>
<% include ../partials/navbar %>
<div class="container">
    <h1>Find lokale fødevarer</h1>
    <p>Her finder du et overblik over økologiske fødevarefællesskaber, gårdbutikker, markeder m.m.
    </p>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% places.forEach(function(places){ %>
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img class="img-responsive" src="<%= places.image %>">
                    <div class="caption">
                        <p class="type"> <%= places.type %> </p>
                        <h4> <%= places.name %> </h4>
                        <p>
                            <a href="/places/<%= places._id %>" class="btn btn-success">Mere Info</a>
                        </p>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<% include ../partials/footer %>