<% include ../partials/header %>
<% include ../partials/navbar %>
<div class="container">
    <h1>Lokale økologiske fødevarer</h1>
    <h2>Find sted nær dig</h2>
    <form action="/places/search" method="POST">
        <div class="input-group">
            <input class="form-control" type="text" name="location" placeholder="Skriv adresse, by eller postnummer" required>
            <span class="input-group-btn">
                <button type="submit" class="btn btn-success"><i class="fas fa-search"></i> Søg!</button>
            </span>
        </div>
    </form>
    <h2>Oversigt</h2>
    <p>Her finder du et overblik over økologiske fødevarefællesskaber, gårdbutikker, markeder m.m.
    </p>
    <div class="row" style="display:flex; flex-wrap: wrap;">
        <% places.forEach(function(places){ %>
            <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img class="img-responsive" src="<%= places.image %>">
                    <div class="caption">
                        <p class="type"> <%= places.type %> </p>
                        <h4> <%= places.name %> </h4>
                        <p>
                            <a href="/places/<%= places._id %>" class="btn btn-success">Mere Info</a>
                        </p>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<% include ../partials/footer %>