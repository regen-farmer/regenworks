<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-8">
                <div>
                    <h1><%= place.name %></h1>
                    <% if(!(place.action === undefined || place.action === "")){ %>
                        <a href="<%= place.action %>" class="btn btn-success pull-right" target="_blank">Bliv Medlem</a>
                    <% } %>
                    <p><%= place.type %></p>
                    <hr>
                    <p><%= place.description %></p>
                    <hr>
                    <% if (place.products){ %>
                        <h2>Produkter i butikken</h2>
                        <div class="row">
                            <% place.products.forEach(function(product){ %>
                                <div class="col-xs-6 col-sm-3">
                                    <div class="well well-sm">
                                        <p><%= product.name %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <hr>
                    <% } %>
                    <% if(currentUser && place.owner.id.equals(currentUser._id)){ %>
                    <a class="btn btn-success" href="/places/<%= place._id %>/experiences/new">Opret oplevelse</a>
                    <a class="btn btn-success" href="/places/<%= place._id %>/services/new">Opret ydelse</a>
                    <a class="btn btn-warning" href="/places/<%= place._id %>/edit">Rediger</a>
                    <form class="delete-form" action="/places/<%= place._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Slet</button>
                    </form>
                    <% } %>
                    <% if(!(place.experiences == "")){ %>
                        <h2>Oplevelser og arrangementer hos <%= place.name %></h2>
                        <% place.experiences.forEach (function(experience){ %>
                            <div class="col-md-6 col-sm-6">
                                <div class="thumbnail">
                                    <div class="caption">
                                        <h4> <%= experience.name %> </h4>
                                        <p> <%= experience.start.date %> kl. <%= experience.start.time %></p>
                                        <a href="/experiences/<%= experience._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                                        <% if(!(experience.price === "")){ %>
                                            <p> <%= experience.price %> kr. pr. person </p>
                                        <% } else { %>
                                            <p> gratis </p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
        </div>
        <div class="col-md-4">
            <img class="img-responsive thumbnail" src="<%= place.image %>">
            <p><i class="fas fa-map-marker"></i> <%= place.location %></p>
            <a class="btn btn-success" href="https://www.google.com/maps/dir/?api=1&destination=<%= place.lat %>+<%= place.lng %>" target="_blank">Find Rute</a>
            <hr>
            <p><strong>Åbningstider: </strong></p>
            <div class="well">
                <p>Mandag:
                    <% if(place.hours.mon.open === "" || place.hours.mon.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.mon.open %> - <%= place.hours.mon.close %></p>
                    <% } %>
                <p>Tirsdag:
                    <% if(place.hours.tue.open === "" || place.hours.tue.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.tue.open %> - <%= place.hours.tue.close %></p>
                    <% } %>
                <p>Onsdag:
                    <% if(place.hours.wed.open === "" || place.hours.wed.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.wed.open %> - <%= place.hours.wed.close %></p>
                    <% } %>
                <p>Torsdag:
                    <% if(place.hours.thu.open === "" || place.hours.thu.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.thu.open %> - <%= place.hours.thu.close %></p>
                    <% } %>
                <p>Fredag:
                    <% if(place.hours.fri.open === "" || place.hours.fri.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.fri.open %> - <%= place.hours.fri.close %></p>
                    <% } %>
                <p>Lørdag:
                    <% if(place.hours.sat.open === "" || place.hours.sat.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.sat.open %> - <%= place.hours.sat.close %></p>
                    <% } %>
                <p>Søndag:
                    <% if(place.hours.sun.open === "" || place.hours.sun.close === ""){ %>
                        lukket
                    <% } else { %>
                        <%= place.hours.sun.open %> - <%= place.hours.sun.close %></p>
                    <% } %>
            </div>
            <p><strong>Telefon:</strong> <%= place.phone %></p>
            <p><strong>Email:</strong> <a href="mailto:<%= place.email %>"><%= place.email %></a></p>
            <a class="btn btn-primary" href="<%= place.website %>">Hjemmeside</a>
        </div>
    </div>
</div>

<% include ../partials/footer %>