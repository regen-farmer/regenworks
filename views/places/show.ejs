<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-8">
                <div class="caption">
                    <h1><%= place.name %></h1>
                    <p><%= place.type %></p>
                    <hr>
                    <p><%= place.description %></p>
                    <hr>
                    <% if (place.products){ %>
                        <h2>Produkter</h2>
                        <div class="row">
                            <% place.products.forEach(function(product){ %>
                                <div class="col-md-3">
                                    <div class="well well-sm">
                                        <p><%= product.name %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                        <hr>
                    <% } %>
                    <% if(currentUser && place.owner.id.equals(currentUser._id)){ %>
                    <a class="btn btn-warning" href="/places/<%= place._id %>/edit">Rediger</a>
                    <form class="delete-form" action="/places/<%= place._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Slet</button>
                    </form>
                    <% } %>
                </div>
        </div>
        <div class="col-md-4">
            <img class="img-responsive" src="<%= place.image %>">
            <h2>Adresse</h2>
            <p><i class="fas fa-map-marker"></i> <%= place.location %></p>
            <h2>Kontakt</h2>
            <p>Tlf: <%= place.phone %></p>
            <p>email: <%= place.email %></p>
            <p>Hjemmeside: <%= place.website %></p>
        </div>
    </div>
</div>

<% include ../partials/footer %>