<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Opdater informationer for <%= place.name %></h2>
            <div>
                <form action="/places/<%= place._id %>?_method=PUT" method="POST">
                    <p>Her kan du tilføje et nyt sted til fællesskabet. </p>
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                            <% if(place.type === "Gårdbutik"){ %>
                                <label class="btn btn-success active">
                                    <input type="radio" name="place[type]" checked="checked" value="Gårdbutik" autocomplete="off" required> Gårdbutik
                                </label>
                            <% } else { %>
                                <label class="btn btn-success">
                                    <input type="radio" name="place[type]" value="Gårdbutik" autocomplete="off" required> Gårdbutik
                                </label>
                            <% } %>
                            <% if(place.type === "Fødevarefællesskab"){ %>
                                <label class="btn btn-success active">
                                    <input type="radio" name="place[type]" checked="checked" value="Fødevarefællesskab" autocomplete="off"> Fødevarefællesskab
                                </label>
                            <% } else { %>
                                <label class="btn btn-success">
                                    <input type="radio" name="place[type]" value="Fødevarefællesskab" autocomplete="off"> Fødevarefællesskab
                                </label>
                            <% } %>
                            <% if(place.type === "Marked"){ %>
                                <label class="btn btn-success active">
                                    <input type="radio" name="place[type]" checked="checked" value="Marked" autocomplete="off"> Marked
                                </label>
                            <% } else { %>
                                <label class="btn btn-success">
                                    <input type="radio" name="place[type]" value="Marked" autocomplete="off"> Marked
                                </label>
                            <% } %>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Navn</label>
                        <input type="text" class="form-control" name="place[name]" value="<%= place.name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Billedelink</label>
                        <input class="form-control" type="text" name="place[image]" value="<%= place.image %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Beskrivelse</label>
                        <input type="text" class="form-control" name="place[description]" value="<%= place.description %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Adresse</label>
                        <input type="text" class="form-control" name="place[location]" value="<%= place.location %>" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Telefonnummer</label>
                        <input type="text" class="form-control" name="place[phone]" value="<%= place.phone %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Kontakt email</label>
                        <input type="text" class="form-control" name="place[email]" value="<%= place.email %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Hjemmeside</label>
                        <input type="text" class="form-control" name="place[website]" value="<%= place.website %>">
                    </div>
                    <div class="form-group">
                        <label for="place[action]">Link til knap</label>
                        <input type="text" class="form-control" name="place[action]" value="<%= place.action %>">
                    </div>
                    <div class="form-group">
                        <label for="place[hours]">Åbningstider</label>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Mandag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][mon][open]" value="<%= place.hours.mon.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][mon][close]" value="<%= place.hours.mon.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Tirsdag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][tue][open]" value="<%= place.hours.tue.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][tue][close]" value="<%= place.hours.tue.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Onsdag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][wed][open]" value="<%= place.hours.wed.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][wed][close]" value="<%= place.hours.wed.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Torsdag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][thu][open]" value="<%= place.hours.thu.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][thu][close]" value="<%= place.hours.thu.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Fredag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][fri][open]" value="<%= place.hours.fri.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][fri][close]" value="<%= place.hours.fri.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Lørdag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][sat][open]" value="<%= place.hours.sat.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][sat][close]" value="<%= place.hours.sat.close %>">
                                </div>
                            </row>
                        </div>
                        <div class="input-group">
                            <row>
                                <div class="col-lg-2">
                                    <p>Søndag</p>
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][sun][open]" value="<%= place.hours.sun.open %>">
                                </div>
                                <div class="col-lg-5">
                                    <input type="time" class="form-control" name="place[hours][sun][close]" value="<%= place.hours.sun.close %>">
                                </div>
                            </row>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Produkter</label>
                        <div class="form-group">
                            <div class="row">
                                <% products.forEach(function(product){ %>
                                    <% if(placeProducts.includes(product._id.toString())){ %>
                                        <div class="col-lg-3">
                                            <div data-toggle="buttons">
                                                <label class="btn btn-default btn-block active">
                                                    <input type="checkbox" checked="checked" autocomplete="off" name="productids" value="<%= product._id %>"><p><%= product.name %></p>
                                                </label>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <div class="col-lg-3">
                                            <div data-toggle="buttons">
                                                <label class="btn btn-default btn-block">
                                                    <input type="checkbox" autocomplete="off" name="productids" value="<%= product._id %>"><p><%= product.name %></p>
                                                </label>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-lg">Opdater informationer</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<% include ../partials/footer %>