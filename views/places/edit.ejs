<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Opdater informationer for <%= place.name %></h2>
            <div>
                <form action="/places/<%= place._id %>?_method=PUT" method="POST">
                    <p>Her kan du tilføje et nyt sted til fællesskabet. </p>
                    <div class="btn-group btn-group-toggle" data-toggle="buttons">
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Gårdbutik" autocomplete="off"> Gårdbutik
                        </label>
                        <label class="btn btn-success active">
                            <input type="radio" name="place[type]" value="Fødevarefællesskab" autocomplete="off"> Fødevarefællesskab
                        </label>
                        <label class="btn btn-success">
                            <input type="radio" name="place[type]" value="Vejbod" autocomplete="off"> Vejbod
                        </label>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Navn</label>
                        <input type="text" class="form-control" name="place[name]" value="<%= place.name %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Billedelink</label>
                        <input class="form-control" type="text" name="place[image]" value="<%= place.image %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Beskrivelse</label>
                        <input type="text" class="form-control" name="place[description]" value="<%= place.description %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Adresse</label>
                        <input type="text" class="form-control" name="place[location]" value="<%= place.location %>">
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Produkter</label>
                        <div class="form-group">
                            <% products.forEach(function(product){ %>
                            <div class="col-lg-4">
                                <div data-toggle="buttons">
                                    <label class="btn btn-default btn-block">
                                        <input type="checkbox" autocomplete="off" name="productids" value="<%= product._id %>"><p><%= product.name %></p>
                                    </label>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-lg">Opdater informationer</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<% include ../partials/footer %>