<% include ../partials/header %>
<% include ../partials/navbar %>

<div>
    <h1><%= budget.name %></h1>
    <p><small>- As initial postings are automatically generated, please check all values and update them with more up to date local prices where applicable. -</small></p>
    <table class="table">
        <tr class="table-secondary">
            <td>Name</td>
            <td>Amount</td>
            <td>Value</td>
            <td>Total</td>
        </tr>
        <% budget.postings.forEach(function(posting){ %>
            <tr>
                <td><%= posting.name %> (<%= posting.postType %>)</td>
                <td><%= posting.amount %></td>
                <td><%= posting.value %> <%= budget.currency %></td>
                <td><%= posting.value * posting.amount %> <%= budget.currency %></td>
            </tr>
        <% }); %>
        <tr class="table-primary">
            <td>Sum</td>
            <td></td>
            <td></td>
            <td><%= total %> <%= budget.currency %></td>
        </tr>
    </table>
    <a href="/budgets/<%= budget._id %>/postings/new" class="btn btn-outline-primary">Add new posting</a>
</div>

<% include ../partials/footer %>