<% include ../partials/header %>
<% include ../partials/navbar %>

<div>
    <h1><%= budget.name %></h1>
    <p><small>- As initial postings are automatically generated, please update values with local prices where applicable. We are continuously improving our models and dataset, but we recommend that you check all postings to ensure local accuracy. -</small></p>
    <table class="table">
        <tr class="table-secondary">
            <td>Name</td>
            <td>Amount</td>
            <td>Value</td>
            <td>Total</td>
            <td></td>
        </tr>
        <% budget.postings.forEach(function(posting){ %>
            <tr>
                <td><%= posting.name %> (<%= posting.postType %>)</td>
                <td><%= posting.amount %></td>
                <td><%= posting.value %> <%= budget.currency %></td>
                <td><%= posting.value * posting.amount %> <%= budget.currency %></td>
                <td><a href="/budgets/<%= budget._id %>/postings/<%= posting._id %>/edit" class="btn btn-outline-secondary">Edit posting</a></td>
            </tr>
        <% }); %>
        <tr class="table-primary">
            <td>Sum</td>
            <td></td>
            <td></td>
            <td><%= total %> <%= budget.currency %></td>
            <td></td>
        </tr>
    </table>
    <a href="/budgets/<%= budget._id %>/postings/new" class="btn btn-outline-primary">Add new posting</a>
</div>

<% include ../partials/footer %>