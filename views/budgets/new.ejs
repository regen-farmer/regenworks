<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h2>Create budget for project "<%= project.name %>"</h2>
            <form action="/projects/<%= project.id %>/budgets" method="POST">
                <p>Estimated values. Change them yourself.</p>
                    <div class="form-group">
                        <select name="budget[currency]" id="budget[currency]">
                            <option value="usd">USD</option>
                            <option value="eur">EUR</option>
                        </select>
                    </div>
                <h2>Area specific activities</h2>
                <p>Site prep: </p>
                <h2>Species specific activities</h2>
                <% species.forEach(function(species){ %>
                    <% for(i=0;i<species.activities.length;i++){ %>
                        <p><%= species.activities[i].name %></p>
                    <% }; %>
                <% }); %>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg">Create budget</button>
                </div>
            </form>
        </div>
        <div class="col-lg-2"></div>
    </div>

<% include ../partials/footer %>