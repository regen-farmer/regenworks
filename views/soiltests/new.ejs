<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">

    <div class="col-lg-3"></div>

    <div class="col-lg-6">
        <h2>Add soil test data</h2>
        <div>
            <form action="/parcels/<%= parcel._id %>/layers/<%= parcel._id %>/soiltests" method="POST">
                <div class="form-group">
                    <label for="soiltest[name]">Name</label>
                    <input type="text" class="form-control" name="soiltest[name]" required>
                </div>
                <div class="form-group">
                    <label for="soiltest[description]">Note</label>
                    <input type="text" class="form-control" name="soiltest[description]" >
                </div>
                <div class="form-group">
                    <label for="soiltest[depth]">Depth in cm</label>
                    <input type="number" class="form-control" name="soiltest[depth]" required>
                </div>
                <div class="form-group">
                    <label for="coordinates">Coordinates</label>
                    <input type="text" class="form-control" name="coordinates" >
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg">Add soil test</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-6"></div>
</div>


<% include ../partials/footer %>