<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-12">

        </div>
        <div class="col-md-4">
            <div>
                <div id="layerMapShow"></div>
                <h2>Area: "<%= layer.name %>"</h2>
                <p><%= layer.description %></p>
                <hr>
                <% if(currentUser && layer.owner.id.equals(currentUser._id)){ %>
                <a class="btn btn-outline-primary" href="/layers/<%= layer._id %>/edit">Edit area</a>
                <form class="delete-form" action="/layers/<%= layer._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger">Delete Area</button>
                </form>
                <% } %>
            </div>
        </div>
        <div class="col-md-8">
            <h2>Area production system</h2>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="home-tab" data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Current system</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="layout-tab" data-toggle="tab" href="#layout" role="tab" aria-controls="layout" aria-selected="false">Current layout</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Plan new agroforestry system</a>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                    <div class="row">
                        <div class="col-md-6">
                            <% if(!(layer.systems.present == "")){ %>
                            <div class="row">
                                <% if(presentsystem.rows){ %>
                                <% presentsystem.rows.forEach(function(row, i){ %>
                                <% if(row.sequense[0].form === "tree"){ %>
                                <% if(row.sequense[0].height > 12){ %>
                                <div class="col-sm-3">
                                    <img class="img-fluid" src="/images/treehigh.svg">
                                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                                </div>
                                <% } else { %>
                                <div class="col-sm-3">
                                    <img class="img-fluid" src="/images/treelow.svg">
                                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                                </div>
                                <% } %>
                                <% } else { %>
                                <div class="col-sm-3">
                                    <img class="img-fluid" src="/images/<%= row.sequense[0].form %>.svg">
                                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                                </div>
                                <% } %>
                                <% }); %>
                                <% } %>
                            </div>
                            <div class="row">
                                <% if(presentsystem.rows){ %>
                                <% presentsystem.rows.forEach(function(row){ %>
                                <div class="col-sm-3">
                                    <% row.sequense.reverse().forEach(function(sequense){ %>
                                    <img class="img-fluid" src="/images/<%= sequense.form %>top.svg">
                                    <p class="text-center"><%= sequense.nameCommon %></p>
                                    <% }); %>
                                </div>
                                <% }); %>
                                <% } %>
                            </div>
                            <p>The current production system has been defined as "<%= layer.type %>" - <i><%= layer.systems.present.name %></i></p>
                            <p></p>
                            <% if(presentsystem.animals.length > 0){ %>
                            <p>Animals: <%= presentsystem.animals[0].name %></p>
                            <% } %>
                            <a class="btn btn-outline-secondary" href="/systems/<%= layer.systems.present._id %>">See more details on current system</a>
                            <% } %>
                        </div>
                        <div class="col-md-6">
                            <% if(!(layer.systems.present == "")){ %><div class="thumbnail">
                                <div class="card">
                                    <div class="card-body">
                                        <h5 class="card-title">Current system species</h5>
                                        <table class="table table-striped small">
                                            <tr>
                                                <td><strong>Layer</strong></td>
                                                <td><strong>Species</strong></td>
                                            </tr>
                                            <tr>
                                                <td>Canopy</td>
                                                <td>
                                                    <% species.forEach(function(species){ %>
                                                    <% if(species.form == "tree" || species.form == "palm" ){ %>
                                                    <em><%= species.nameCommon %>,</em>
                                                    <% } %>
                                                    <% }); %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Sub-canopy</td>
                                                <td>
                                                    <% species.forEach(function(species){ %>
                                                    <% if(species.form == "shrub" || species.form == "giantherb" ){ %>
                                                    <em><%= species.nameCommon %>,</em>
                                                    <% } %>
                                                    <% }); %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Climbers</td>
                                                <td>
                                                    <% species.forEach(function(species){ %>
                                                    <% if(species.form == "vine"){ %>
                                                    <em><%= species.nameCommon %>,</em>
                                                    <% } %>
                                                    <% }); %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>Ground</td>
                                                <td>
                                                    <% species.forEach(function(species){ %>
                                                    <% if(species.form == "herb" || species.form == "grass" ){ %>
                                                    <em><%= species.nameCommon %>,</em>
                                                    <% } %>
                                                    <% }); %>
                                                </td>
                                            </tr>
                                        </table>
                                        <a class="btn btn-outline-primary" href="/systems/<%= layer.systems.present._id %>/composition">Analyse species succession</a>
                                    </div>

                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="layout" role="tabpanel" aria-labelledby="layout-tab">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Current layout</h5>
                            <p class="card-text">System layout: N/A</p>
                            <p class="card-text">System alignment: N/A</p>
                            <p class="card-text">Area size: <%= (layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
                            <a href="/layers/<%= layer._id %>/layout" class="btn btn-primary">View current system layout</a>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                    <% if(!(layer.systems.future == "")){ %>
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title">Saved future agroforestry system drafts</h5>
                            <% layer.systems.future.forEach(function(system){ %>
                            <div class="card bg-light">
                                <div class="card-body">
                                    <p class="card-text"><%= system.name %></p>
                                    <a class="btn btn-outline-primary" href="/systems/<%= system._id %>">View more details</a>
                                    <button class="btn btn-outline-warning" data-toggle="modal" data-target="#setCurrentModal<%= system._id %>">Create implementation project for this system</button>
                                    <!-- Modal -->
                                    <div class="modal fade" id="setCurrentModal<%= system._id %>" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                        <div class="modal-dialog" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h4 class="modal-title" id="exampleModalLabel">Set system "<%= system.name %>" to current</h4>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>You are about to change the current production system for this area.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <a class="btn btn-success" href="/layers/<%= layer._id %>/projects/new/<%= system._id %>">Create project</a>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                            <% if(layer.systems.future.length > 1){ %>
                                <a class="btn btn-outline-secondary mt-2" href="/layers/<%= layer._id %>/systems/compare">Compare future systems</a>
                            <% } %>
                        </div>
                    </div>
                    <% } %>
                    <a class="btn btn-success mt-2" href="/layers/<%= layer._id %>/systems/new">Define new agroforestry system from scratch</a>
                    <a class="btn btn-primary mt-2" href="/layers/<%= layer._id %>/analysis">Get a headstart with the agroforestry suitability analysis</a>
                </div>
            </div>
        </div>
    </div>

<script>
    var areaLat = "<%= layer.lat %>";
    var areaLng = "<%= layer.lng %>";

    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 15,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#7F22C0',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });
    });

</script>

<% include ../partials/footer %>