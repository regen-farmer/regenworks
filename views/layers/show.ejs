<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-md-12">

        </div>
        <div class="col-md-4">
            <div>
                <div id="layerMapShow"></div>
                <h2>Area: "<%= layer.name %>"</h2>
                <p><%= layer.description %></p>
                <hr>
                <% if(currentUser && layer.owner.id.equals(currentUser._id)){ %>
                <a class="btn btn-default" href="/layers/<%= layer._id %>/edit">Edit area</a>
                <form class="delete-form" action="/layers/<%= layer._id %>?_method=DELETE" method="POST">
                    <button class="btn btn-danger">Delete Area</button>
                </form>
                <% } %>
                <h2>Area details</h2>
                <p>Area type: <%= layer.type %> </p>
                <p>Area size: <%= (layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
                <p>Current system type: N/A</p>
                <p>System layout: N/A</p>
                <p>System alignment: N/A</p>
                <hr>
            </div>
        </div>
        <div class="col-md-4">
            <h2>Current area system</h2>
            <p>The current production system has been defined as "<%= layer.type %>".</p>
            <% if(!(layer.systems.present == "")){ %>
                <p><%= layer.systems.present.name %></p>
            <div class="row">
                <% if(presentsystem.rows){ %>
                <% presentsystem.rows.forEach(function(row, i){ %>
                <% if(row.sequense[0].form === "tree"){ %>
                <% if(row.sequense[0].height > 12){ %>
                <div class="col-sm-3">
                    <img class="img-responsive" src="/images/treehigh.svg">
                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                </div>
                <% } else { %>
                <div class="col-sm-3">
                    <img class="img-responsive" src="/images/treelow.svg">
                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                </div>
                <% } %>
                <% } else { %>
                <div class="col-sm-3">
                    <img class="img-responsive" src="/images/<%= row.sequense[0].form %>.svg">
                    <p class="text-center">Row <%= i %> - <%= row.width %> m</p>
                </div>
                <% } %>
                <% }); %>
                <% } %>
            </div>
            <div class="row">
                <% if(presentsystem.rows){ %>
                <% presentsystem.rows.forEach(function(row){ %>
                <div class="col-sm-3">
                    <% row.sequense.reverse().forEach(function(sequense){ %>
                    <img class="img-responsive" src="/images/<%= sequense.form %>top.svg">
                    <p class="text-center"><%= sequense.nameCommon %></p>
                    <% }); %>
                </div>
                <% }); %>
                <% } %>
            </div>
            <a class="btn btn-default" href="/systems/<%= layer.systems.present._id %>">See more details on current system</a>
            <hr>
            <div class="thumbnail">
                <div class="caption">
                    <h2>Current system layers</h2>
                    <table class="table table-striped">
                        <tr>
                            <td><strong>Layer</strong></td>
                            <td><strong>Species</strong></td>
                        </tr>
                        <tr>
                            <td>Canopy</td>
                            <td>
                                <% species.forEach(function(species){ %>
                                <% if(species.form == "tree" || species.form == "palm" ){ %>
                                <em><%= species.nameCommon %>,</em>
                                <% } %>
                                <% }); %>
                            </td>
                        </tr>
                        <tr>
                            <td>Sub-canopy</td>
                            <td>
                                <% species.forEach(function(species){ %>
                                <% if(species.form == "shrub" || species.form == "giantherb" ){ %>
                                <em><%= species.nameCommon %>,</em>
                                <% } %>
                                <% }); %>
                            </td>
                        </tr>
                        <tr>
                            <td>Climbers</td>
                            <td>
                                <% species.forEach(function(species){ %>
                                <% if(species.form == "vine"){ %>
                                <em><%= species.nameCommon %>,</em>
                                <% } %>
                                <% }); %>
                            </td>
                        </tr>
                        <tr>
                            <td>Ground</td>
                            <td>
                                <% species.forEach(function(species){ %>
                                <% if(species.form == "herb" || species.form == "grass" ){ %>
                                <em><%= species.nameCommon %>,</em>
                                <% } %>
                                <% }); %>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
            <% } %>
        </div>
        <div class="col-md-4">
            <h2>Plan new agroforestry system</h2>
            <% if(!(layer.systems.future == "")){ %>
            <p>Saved future system drafts</p>
            <% layer.systems.future.forEach(function(system){ %>
                <div class="thumbnail">
                    <div class="caption">
                        <p><%= system.name %></p>
                        <a class="btn btn-default" href="/systems/<%= system._id %>">View more details</a>
                        <button class="btn btn-warning" data-toggle="modal" data-target="#setCurrentModal">Set as current system</button>
                        <!-- Modal -->
                        <div class="modal fade" id="setCurrentModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h4 class="modal-title" id="exampleModalLabel">Set system "<%= system.name %>" to current</h4>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <p>You are about to change the current production system for this area.</p>
                                    </div>
                                    <div class="modal-footer">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <form action="/layers/<%= layer._id %>/presentsystem" method="POST">
                                                    <input type="hidden" id="systemid" name="systemid" value="<%= system._id %>">
                                                    <button class="btn btn-warning pull-left">Change current system</button>
                                                </form>
                                            </div>
                                            <div class="col-md-6">
                                                <button type="button" class="btn btn-secondary pull-right" data-dismiss="modal">Cancel change and close this window</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
            <% } %>
            <% if(layer.systems.future.length > 1){ %>
            <% } %>
            <a class="btn btn-success" href="/layers/<%= layer._id %>/systems/new">Define new agroforestry system from scratch</a>
            <a class="btn btn-primary" href="/layers/<%= layer._id %>/analysis">Get a headstart with the agroforestry suitability analysis</a>
            <h2>See production system timeline</h2>
            <a class="btn btn-default" href="/layers/<%= layer._id %>/systems">See timeline</a>
        </div>
    </div>
</div>

<script>
    var areaLat = "<%= layer.lat %>";
    var areaLng = "<%= layer.lng %>";

    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/streets-v9',
        center: [areaLng, areaLat],
        zoom: 14,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#6EBC4A',
                'fill-opacity': 0.6
            }
        });
    });

</script>

<% include ../partials/footer %>