<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <h1>Area: "<%= layer.name %>"</h1>
        <div class="col-md-8">
            <div>
                <h2>Area system</h2>
                <h2>Layout</h2>
                <div class="row">
                    <div class="col-md-4">
                        <img class="img-responsive" src="/images/banana.svg">
                    </div>
                    <div class="col-md-4">
                        <img class="img-responsive" src="/images/euca.svg">
                    </div>
                    <div class="col-md-4">
                        <img class="img-responsive" src="/images/banana.svg">
                    </div>
                </div>
            </div>
            <h2>System layers/rows</h2>
            <div class="col-md-12">
                <a href="/layers/<%= layer._id %>" class="btn btn-default btn-block">
                    <p>"<%= layer.name %>" Area Type: "<%= layer.type %>"</p>
                </a>
            </div>
        </div>
        <div class="col-md-4">
            <div>
                <h2>Area details</h2>
                <p>Area type: <%= layer.type %> </p>
                <p>Area size: <%= (layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
                <p>System type: Multstrata agroforestry</p>
                <p>System layout: Straight rows</p>
                <p>System alignment: North/south</p>
                <div id="layerMapShow"></div>
                <hr>
                <% if(currentUser && layer.owner.id.equals(currentUser._id)){ %>
                    <a class="btn btn-default" href="/layers/<%= layer._id %>/edit">Edit area</a>
                    <form class="delete-form" action="/layers/<%= layer._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete Area</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>
</div>

<script>
    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/streets-v9',
        center: [11.569984, 54.808400],
        zoom: 15,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#6EBC4A',
                'fill-opacity': 0.6
            }
        });
    });

</script>

<% include ../partials/footer %>