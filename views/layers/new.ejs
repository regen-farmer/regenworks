<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h2>Add layer to "<%= parcel.name %>"</h2>
            <div>
            <form action="/parcels/<%= parcel._id %>/layers" method="POST">
                <div class="form-group">
                    <label for="layer[name]">Layer name</label>
                    <input type="text" class="form-control" name="layer[name]" placeholder="Give the layer a name - Descriptive is often best" required>
                </div>
                <div class="form-group">
                    <label for="layer[description]">Description</label>
                    <input type="text" class="form-control" name="layer[description]" placeholder="Describe what is on the layer: apple orchard, cereal crops, grazing area, etc.">
                </div>
                <div class="form-group">
                    <!-- Button trigger modal -->
                    <a class="pull-right"data-toggle="modal" data-target="#layerTypesModal">View layer type definitions</a>
                    <label for="layer[type]">Layer type</label>
                    <select class="form-control" name="layer[type]">
                        <option value="field">Field/Bed (Crops)</option>
                        <option value="patch">Patch (Pasture/grassland)</option>
                        <option value="stand">Stand (Forest/shrubs)</option>
                        <option value="water">Water (Lakes/ponds)</option>
                        <option value="soil">Soil (sub-surface organisms)</option>
                    </select>
                    <!-- Modal -->
                    <div class="modal fade" id="layerTypesModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h4 class="modal-title" id="exampleModalLabel">Layer type definitions</h4>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <p>Below is the list of current layer types and what each layer type represents.</p>
                                    <ul>
                                        <li><strong>Field/bed:</strong> Area cultivated with annual crops such as cereals, vegetables or natural fiber crops.</li>
                                        <li><strong>Patch:</strong> Area with grass primarily used for grazing.</li>
                                        <li><strong>Stand:</strong> Area with some form of treecover, shrubs or perennial energy crops.</li>
                                        <li><strong>Water:</strong> Larger open bodies of water like ponds or lakes.</li>
                                        <li><strong>Soil:</strong> This layer is used if underground microbal life and fungi is actively managed.</li>
                                    </ul>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close this window</button>
                                </div>
                            </div>
                        </div>
                    </div>
                <p><em><small>If you have different overlapping activities we recommend that you make a layer for each type. (Example: a tree (stand) layer and a pasture (patch) layer for Silvopasture).</small></em></p>
                </div>
                <div class="form-group">
                    <label for="[layerCoordinates]">Layer geometry</label>
                    <p>Please draw the outline of your new layer. Press "Finish" to close the shape.</p>
                </div>
                <div id="layerMapNew"></div>
                <input type="hidden" id="geometry" name="geometry">
                <input type="hidden" id="layersize" name="layersize">
                <div id="coordinates"></div>
                <hr>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Create new layer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var parcelLat = "<%= parcel.lat %>";
    var parcelLng = "<%= parcel.lng %>";
</script>

<% include ../partials/footer %>