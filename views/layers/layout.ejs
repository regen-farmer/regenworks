<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-6">
            <div id="layerMapShow"></div>
            <a href="/layers/<%= layer._id %>" class="btn mt-2 btn-outline-primary">Back to area page</a>
            <a href="/layers/<%= layer._id %>/row/new" class="btn mt-2 btn-outline-secondary">Manually add existing row</a>
        </div>
        <!--<div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h2>Existing assets</h2>
                </div>
            </div>
        </div>-->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2>Existing rows</h2>
                    <table class="table small">
                        <tr class="table-secondary">
                            <td>Row ref</td>
                            <td>Row system pattern</td>
                            <td></td>
                        </tr>
                    <% if(layer.rows && layer.rows.length > 0){ %>
                        <% for(i=0;i<layer.rows.length;i++){ %>
                            <tr>
                                <td><%= layer.rows[i].name %></td>
                                <% if(layer.rows[i].system){ %>
                                <td><%= layer.rows[i].system.name %> <%= layer.rows[i].system.model[0].species.nameCommon %></td>
                                <% } else { %>
                                <td>---</td>
                                <% } %>
                                <td>
                                    <a href="/layers/<%= layer._id %>/row/edit?index=<%= i %>" class="btn btn-sm mt-2 btn-outline-warning">Edit row</a>
                                </td>
                            </tr>
                        <% } %>
                    <% } %>
                    </table>
                </div>
            </div>
        </div>
    </div>

<script>
    var areaLat = "<%= layer.lat %>";
    var areaLng = "<%= layer.lng %>";

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var col = "<%= collection %>";
    var correctcol = JSON.parse(col.replace(/&#34;/g,'"'));

    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));

    var placecollection = "<%= places %>";
    var places = JSON.parse(placecollection.replace(/&#34;/g,'"'));

    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 16,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#fff1ff',
                'fill-opacity': 0.5,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map1',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data': correctcol
            },
            'layout': {},
            'paint': {
                'line-color': '#1f1f1f',
            }
        });

        map.addLayer({
            'id': 'poi-labels',
            'type': 'symbol',
            'source': {
                'type': 'geojson',
                'data': places
            },
            'layout': {
                'text-field': ['get', 'description'],
                'text-justify': 'center',
                'icon-image': ['concat', ['get', 'icon'], '-15']
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#5cb85c'
            }
        });

    });

</script>

<% include ../partials/footer %>