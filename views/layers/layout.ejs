<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-5">
            <div id="layerMapShow"></div>
            <a href="/layers/<%= layer._id %>" class="btn mt-2 btn-outline-primary">Back to area page</a>
        </div>
        <div class="col-md-3">
            <h2>System layout</h2>
            <div class="row">
                <% if(presentsystem.sortedrows.length > 0){ %>
                    <% presentsystem.sortedrows.forEach(function(row){ %>
                        <div class="col-sm-3">
                            <% row.array.forEach(function(species){ %>
                                <img class="img-fluid" src="/images/<%= species.species.form %>top.svg">
                                <p class="text-center"><%= species.species.nameCommon %></p>
                            <% }); %>
                        </div>
                    <% }); %>
                <% } %>
            </div>
            <p><i><%= presentsystem.name %></i></p>
            <p>Area size: <%= (layer.size * 0.0001).toFixed(2) %> hectare(s)</p>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5>Change parameters</h5>
                    <form action="/layers/<%= layer._id %>?_method=PUT" method="POST">
                        <div class="form-group">
                            <label for="layer[layout]">Layout type</label>
                            <select class="form-control" name="layer[layout]">
                                <% if(layer.layout === "straight") { %>
                                <option selected="selected" value="straight">Straight rows</option>
                                <% } else { %>
                                <option value="straight">Straight rows</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="layer[alignment]">Alignment</label>
                            <select class="form-control" name="layer[alignment]">
                                <% if(layer.alignment === "north") { %>
                                <option selected="selected" value="north">North/south</option>
                                <% } else { %>
                                <option value="north">North/south</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="layer[headland]">Headland</label>
                            <input type="number" min="0" max="10" class="form-control" name="layer[headland]" value="<%= layer.headland %>">
                        </div>
                        <div class="btn-group">
                            <button type="submit" class="btn btn-success btn-lg center-block">Update parameters</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

<script>
    var areaLat = "<%= layer.lat %>";
    var areaLng = "<%= layer.lng %>";

    var col = "<%= collection %>";
    var correctcol = JSON.parse(col.replace(/&#34;/g,'"'));

    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));
    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 15,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#7F22C0',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map1',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data': correctcol
            },
            'layout': {},
            'paint': {
                'line-color': '#fff1ff',
            }
        });
    });

</script>

<% include ../partials/footer %>