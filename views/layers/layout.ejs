<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-6">
            <div id="layerMapShow"></div>
            <a href="/layers/<%= layer._id %>" class="btn mt-2 btn-outline-primary">Back to area</a>
            <a href="/layers/<%= layer._id %>/row/new" class="btn mt-2 btn-outline-secondary">Draw row/line on map</a>
            <a href="/layers/<%= layer._id %>/sequences/spacing" class="btn mt-2 btn-outline-success">Create new row species sequence</a>
        </div>
        <!--<div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h2>Existing assets</h2>
                </div>
            </div>
        </div>-->
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2>Existing rows</h2>
                    <table class="table small">
                        <tr class="table-secondary">
                            <td>Row ref</td>
                            <td>Row sequense pattern</td>
                            <td></td>
                        </tr>
                    <% if(layer.rows && layer.rows.length > 0){ %>
                        <% for(i=0;i<layer.rows.length;i++){ %>
                            <tr>
                                <td><%= layer.rows[i].name %></td>
                                <% if(layer.rows[i].sequence){ %>
                                <td><%= layer.rows[i].sequence.name %>
                                    <a href="/layers/<%= layer._id %>/sequences/<%= layer.rows[i].sequence._id %>/edit" class="btn btn-sm btn-outline-warning"><i class="far fa-edit"></i></a>

                                </td>
                                <% } else { %>
                                <td>---</td>
                                <% } %>
                                <td>
                                    <a href="/layers/<%= layer._id %>/row/edit?index=<%= i %>" class="btn btn-sm btn-outline-warning"><i class="far fa-edit"></i></a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-toggle="modal" data-target="#myModalDeleteRow<%= i %>"><i class="far fa-trash-alt"></i></button>
                                </td>
                            </tr>
                            <!-- Modal -->
                            <div class="modal fade" id="myModalDeleteRow<%= i %>" role="dialog">
                                <div class="modal-dialog">
                                    <!-- Modal content-->
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                                            <h4 class="modal-title">Confirm deletion of row</h4>
                                        </div>
                                        <div class="modal-body">
                                            <p>Confirm deletion of row: "<%= layer.rows[i].name %>"</p>
                                        </div>
                                        <div class="modal-footer">
                                            <form class="delete-form" action="/layers/<%= layer._id %>/row?_method=DELETE&index=<%= i %>" method="POST">
                                                <button class="btn btn-sm btn-outline-danger">Delete row <i class="far fa-trash-alt"></i></button>
                                            </form>
                                            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    <% } %>
                    </table>
                </div>
            </div>
        </div>
    </div>

<script>
    var areaLat = "<%= layer.lat %>";
    var areaLng = "<%= layer.lng %>";

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var col = "<%= collection %>";
    var correctcol = JSON.parse(col.replace(/&#34;/g,'"'));

    var getgeometry = "<%= layer.geometry %>";
    var correctgeometry = JSON.parse(getgeometry.replace(/&#34;/g,'"'));

    var placecollection = "<%= places %>";
    var places = JSON.parse(placecollection.replace(/&#34;/g,'"'));

    var treenames = "<%= treenames %>";
    var correcttreenames = JSON.parse(treenames.replace(/&#34;/g,'"'));

    var vegecollection = "<%= vegetables %>";
    var correctvege = JSON.parse(vegecollection.replace(/&#34;/g,'"'));

    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapShow',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [areaLng, areaLat],
        zoom: 16,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#fff1ff',
                'fill-opacity': 0.5,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map1',
            'type': 'line',
            'source': {
                'type': 'geojson',
                'data': correctcol
            },
            'layout': {},
            'paint': {
                'line-color': '#1f1f1f',
            }
        });

        map.addLayer({
            'id': 'poi-labels',
            'type': 'symbol',
            'maxzoom': 20,
            'source': {
                'type': 'geojson',
                'data': places
            },
            'layout': {
                'text-field': ['get', 'description'],
                'text-justify': 'center',
                'icon-image': ['concat', ['get', 'icon'], '-15']
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#5cb85c'
            }
        });

        map.addLayer({
            'id': 'map3',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctvege
            },
            'layout': {},
            'paint': {
                'fill-color': '#002eff'
            }
        });

        map.addLayer({
            'id': 'tree-labels',
            'type': 'symbol',
            'minzoom': 20,
            'source': {
                'type': 'geojson',
                'data': correcttreenames
            },
            'layout': {
                'text-field': ['get', 'description'],
                'text-justify': 'center',
                'icon-image': ['concat', ['get', 'icon'], '-15']
            }
        });

    });

</script>

<% include ../partials/footer %>