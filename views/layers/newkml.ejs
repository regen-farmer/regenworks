<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h2>Add new area to "<%= parcel.name %>"</h2>
        <div>
            <form action="/parcels/<%= parcel._id %>/layersuploadkml" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="layer[name]">Area name</label>
                    <input type="text" class="form-control" name="layer[name]" placeholder="Give the layer a name - Descriptive is often best" required>
                </div>
                <div class="form-group">
                    <label for="layer[description]">Description</label>
                    <input type="text" class="form-control" name="layer[description]" placeholder="Describe what is on the layer: apple orchard, cereal crops, grazing area, etc.">
                </div>
                <div class="form-group">
                    <label for="layer[type]">Existing production type on area</label>
                    <select class="form-control" name="layer[type]">
                        <option value="arable">Crop cultivation</option>
                        <option value="grassland">Pasture/grassland</option>
                        <option value="agroforestry">Agroforestry</option>
                        <option value="orchard">Orchard</option>
                        <option value="forestry">Forest</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="maincrop">Current main crop (If any)</label>
                    <select name="maincrop">
                        <option value="">none</option>
                        <% species.forEach(function(species){ %>
                        <option value="<%= species._id %>"><%= species.nameCommon %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="animal">Current animal (If any)</label>
                    <select name="animal">
                        <option value="">none</option>
                        <% animals.forEach(function(animal){ %>
                        <option value="<%= animal._id %>"><%= animal.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="filename">Upload area geometry file (KML format supported)</label>
                    <input type="file" id="myFile" name="filename" accept="text/kml" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Create new area</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var parcelLat = "<%= parcel.lat %>";
        var parcelLng = "<%= parcel.lng %>";
    </script>

<% include ../partials/footer %>