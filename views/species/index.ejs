<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <h1>Species</h1>
    <a href="/species/new" class="btn btn-success">Add new species</a>
    <table class="table table-striped">
        <tr>
            <td>Common name</td>
            <td>Latin</td>
            <td>Precip</td>
            <td></td>
        </tr>
        <% species.forEach(function(species){ %>
            <tr>
                <td><%= species.nameCommon %></td>
                <td><%= species.genus %> <%= species.species %></td>
                <% if(!(species.precipitation === "")){ %>
                    <td><%= species.precipitation.min %> - <%= species.precipitation.max %></td>
                <% } else { %>
                    <td>no precipitation data</td>
                <% } %>
                <td><a href="/species/<%= species._id %>" class="btn btn-success">Show more</a></td>
            </tr>
        <% }); %>
    </table>
</div>

<% include ../partials/footer %>