<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="container">
    <div class="row">
        <div class="col-sm-3"></div>
        <div class="col-sm-6">
            <h1>Add nutrient profile for species</h1>
            <p>Use this page to create activity templates for species that are used to auto-generate activities for projects.</p>
            <form action="/species/<%= species._id %>/nutrients?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="nutrients[protein]">Protein</label>
                    <input type="number" class="form-control" name="nutrients[protein]" min="0" max="100" required>
                </div>
                <div class="form-group">
                    <label for="nutrients[fat]">Fat</label>
                    <input type="number" class="form-control" name="nutrients[fat]" min="0" max="100" required>
                </div>
                <div class="form-group">
                    <label for="nutrients[carb]">Carbs</label>
                    <input type="number" class="form-control" name="nutrients[carb]" min="0" max="100" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg">Add nutrient profile</button>
                </div>
            </form>
        </div>
        <div class="col-sm-3"></div>
    </div>
</div>

<% include ../partials/footer %>