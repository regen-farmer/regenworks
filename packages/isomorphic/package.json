{
	"name": "isomorphic",
	"scripts": {
		"prebuild": "node scripts/sync-routes.mjs",
		"dev": "concurrently --kill-others-on-fail --names \"routes,vite\" -c \"blue,magenta\" \"node scripts/sync-routes.mjs --watch\" \"vite dev --port 10000\"",
		"lint": "oxlint --import-plugin --jsdoc-plugin ./src",
		"format": "oxfmt --write --ignore-path=.oxfmtignore ./src",
		"typecheck": "tsc --noEmit",
		"build": "vite build",
		"build:e2e": "node scripts/sync-routes.mjs && VITE_BACKEND_URL=${VITE_BACKEND_URL:-https://regenworks-dev-backend.onrender.com} vite build",
		"preview": "vite preview",
		"start": "PORT=${PORT:-10000} node .output/server/index.mjs",
		"start-local": "PORT=${PORT:-10000} node --env-file=.env .output/server/index.mjs",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"type": "module",
	"devDependencies": {
		"@playwright/test": "^1.50.0",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/virtual-file-routes": "^1.161.6",
		"@types/geojson": "^7946.0.14",
		"@types/lodash": "^4.17.20",
		"@types/mailchimp__mailchimp_marketing": "^3.0.21",
		"@types/mailchimp__mailchimp_transactional": "^1.0.11",
		"@types/mapbox__mapbox-gl-draw": "^1.4.9",
		"@xmldom/xmldom": "^0.9.5",
		"concurrently": "^9",
		"puppeteer": "^25.1.0",
		"vite": "^8.0.0",
		"vite-plugin-solid": "^2.11.12"
	},
	"dependencies": {
		"@auth/core": "^0.41.1",
		"@corvu/resizable": "^0.2.5",
		"@corvu/tooltip": "^0.2.2",
		"@deck.gl/core": "^9.1.14",
		"@deck.gl/geo-layers": "^9.1.14",
		"@deck.gl/mapbox": "^9.1.14",
		"@deck.gl/mesh-layers": "^9.1.14",
		"@kobalte/core": "^0.13.11",
		"@mailchimp/mailchimp_marketing": "^3.0.80",
		"@mailchimp/mailchimp_transactional": "^1.0.59",
		"@mapbox/geojson-area": "^0.2.2",
		"@mapbox/mapbox-gl-draw": "^1.4.3",
		"@maptiler/sdk": "^4.0.2",
		"@popperjs/core": "^2.11.8",
		"@rw/db": "workspace:*",
		"@rw/frontend": "workspace:*",
		"@rw/modelling": "workspace:*",
		"@solid-primitives/media": "^2.3.5",
		"@tanstack/solid-router": "^1.168.19",
		"@tanstack/solid-start": "^1.167.36",
		"@tauri-apps/plugin-http": "~2",
		"@tmcw/togeojson": "^7.1.2",
		"@turf/turf": "^7.1.0",
		"@types/proj4": "^2.19.0",
		"chart.js": "^4.5.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"convert-units": "3.0.0-beta.8",
		"date-fns": "^4.1.0",
		"google-auth-library": "^10.6.2",
		"google-spreadsheet": "^4.1.5",
		"jose": "^5.10.0",
		"lodash": "^4.17.21",
		"maplibre-gl": "^5.18.0",
		"maplibre-gl-measures": "^0.0.16",
		"multipart-object": "^1.2.0",
		"postcss": "^8.5.6",
		"proj4": "^2.19.10",
		"solid-js": "^1.9.9",
		"solid-sonner": "^0.3.1",
		"source-map-js": "1.2.1",
		"nitro": "3.0.260415-beta",
		"start-authjs": "^1.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.12",
		"tailwindcss-animate": "^1.0.7"
	}
}
