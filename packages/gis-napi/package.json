{
	"name": "@rw/gis-napi",
	"version": "0.1.0",
	"description": "Native Node.js addon for the GIS layout engine",
	"main": "index.js",
	"napi": {
		"binaryName": "gis-napi",
		"targets": [
			"aarch64-apple-darwin",
			"x86_64-apple-darwin",
			"aarch64-pc-windows-msvc",
			"x86_64-pc-windows-msvc",
			"x86_64-unknown-linux-gnu"
		]
	},
	"scripts": {
		"build": "napi build --platform --release",
		"build:debug": "napi build --platform"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"*.node"
	],
	"devDependencies": {
		"@napi-rs/cli": "^3"
	}
}
