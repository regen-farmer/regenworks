{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for RegenWorks desktop",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://staging.regenfarmer.com",
      "https://staging.regenfarmer.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.regenfarmer.com/*"
        }
      ]
    },
    "core:app:allow-version",
    "core:app:allow-tauri-version"
  ]
}