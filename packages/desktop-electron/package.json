{
	"name": "@rw/desktop-electron",
	"productName": "RegenWorks",
	"version": "2026.1.0-22",
	"description": "RegenWorks Desktop (Electron) - Fast agroforestry planning application",
	"homepage": "https://regenworks.com",
	"author": {
		"name": "RegenWorks",
		"email": "hello@regenworks.com"
	},
	"main": "dist/main.js",
	"scripts": {
		"postinstall": "node scripts/patch-electron-dev.js",
		"dev": "tsc && electron .",
		"build": "tsc",
		"package": "pnpm build && electron-builder --publish never",
		"package:staging": "pnpm build && electron-builder --config electron-builder.staging.yml --publish never"
	},
	"dependencies": {
		"electron-updater": "^6",
		"@rw/gis-napi": "workspace:*"
	},
	"devDependencies": {
		"electron": "^40",
		"electron-builder": "^25",
		"typescript": "^5"
	}
}
