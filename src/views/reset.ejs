<%- include('./partials/header') %>
<%- include('./partials/navbar') %>

<div class="row">
    <div class="col-md-12">
        <form action="/reset/<%= token %>" method="POST">
            <legend>Opret nyt kodeord</legend>
            <div class="form-group">
                <label for="password">Nyt kodeord</label>
                <input type="password" name="password" value="" placeholder="Nyt kodeord" autofocus="autofocus" class="form-control"/>
            </div>
            <div class="form-group">
                <label for="password">Bekræft kodeord</label>
                <input type="password" name="confirm" value="" placeholder="Bekræft kodeord" class="form-control"/>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-success">Opdater kodeord</button>
            </div>
        </form>
    </div>
</div>

<%- include('./partials/footer') %>