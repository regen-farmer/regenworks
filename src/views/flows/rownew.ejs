<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h2>Add flow to row/block</h2>
        <form action="/species/<%= species._id %>/flows" method="POST">
            <div class="form-group">
                <label for="flow[name]">Flow name</label>
                <input type="text" class="form-control" name="flow[name]" placeholder="Give the flow a name" required>
            </div>
            <div class="form-group">
                <label for="flow[description]">Description</label>
                <input type="text" class="form-control" name="flow[description]">
            </div>
            <div class="form-group">
                <label for="flow[type]">Flow type</label>
                <select class="form-control" name="flow[type]">
                    <option value="output">Output/Yield</option>
                    <option value="input">Input</option>
                </select>
            </div>
            <div class="form-group">
                <label for="flow[timestamp]">Date</label>
                <input type="date" class="form-control" name="flow[timestamp]" placeholder="Give the flow a name" required>
            </div>
            <div class="form-group">
                <label for="flow[amount]">Amount</label>
                <input type="number" class="form-control" name="flow[amount]" placeholder="Source of the data" required>
            </div>
            <div class="form-group">
                <label for="flow[unit]">Metric (kg, l, m3...)</label>
                <input type="text" class="form-control" name="flow[unit]" placeholder="Give the flow a name" required>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg center-block">Add flow data</button>
            </div>
        </form>
    </div>
    <div class="col-lg-3"></div>
</div>

<%- include('../partials/footer') %>