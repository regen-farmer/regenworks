<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8">
        <h2>Create new note</h2>
        <div>
            <form action="/parcels/<%= parcelid %>/layers/<%= layerid %>/areas/<%= areaid %>/notes" method="POST">
                <p>Add a new note to sub-area.</p>
                <div class="form-group">
                    <label for="activity[name]">Note name</label>
                    <input type="text" class="form-control" name="activity[name]" placeholder="Give the activity a name" required>
                </div>
                <div class="form-group">
                    <label for="activity[description]">Note description</label>
                    <input type="text" class="form-control" name="activity[description]" placeholder="Give the activity a name">
                </div>
                <div class="btn-group">
                    <button type="submit" class="btn btn-success btn-lg">Create note</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-2"></div>
</div>

<%- include('../partials/footer') %>