<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div>
                <h1>Oplevelser og arrangmenter nær "<%= searchterm %>"</h1>
                <p>Her finder du spændende oplevelser med fokus på økologiske fødevarer og bæredygtige lokale fællesskaber nær dig.
                </p>
                <h3>Under 30 km</h3>
                <div class="row" style="display:flex; flex-wrap: wrap;">
                    <% experiencesBelow.forEach(function(experience){ %>
                    <div class="col-md-3 col-sm-6">
                        <div class="thumbnail">
                            <div class="caption">
                                <h4> <%= experience.name %> </h4>
                                <p class="pull-right"><%= experience.distance %>  km</p>
                                <p> <%= experience.day %> <%= experience.month %> kl. <%= experience.start.time %> </p>
                                <a href="/experiences/<%= experience._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                                <% if(!(experience.price === "")){ %>
                                <p> <%= experience.price %> kr. pr. person </p>
                                <% } else { %>
                                <p> gratis </p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <h3>Over 30 km</h3>
                <div class="row" style="display:flex; flex-wrap: wrap;">
                    <% experiencesAbove.forEach(function(experience){ %>
                    <div class="col-md-3 col-sm-6">
                        <div class="thumbnail">
                            <div class="caption">
                                <h4> <%= experience.name %> </h4>
                                <p class="pull-right"><%= experience.distance %>  km</p>
                                <p> <%= experience.day %> <%= experience.month %> kl. <%= experience.start.time %> </p>
                                <a href="/experiences/<%= experience._id %>" class="btn btn-primary pull-right action-btn">Mere Info</a>
                                <% if(!(experience.price === "")){ %>
                                <p> <%= experience.price %> kr. pr. person </p>
                                <% } else { %>
                                <p> gratis </p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>

</div>

<%- include('../partials/footer') %>