<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-md-2"></div>
        <div class="col-md-8">
            <div>
                <h1> <%= activity.name %> </h1>
                <hr>
                <p><%= day %> <%= month %> kl. <%= activity.start.time %></p>
                <hr>
                <% if(currentUser && activity.owner.id.equals(currentUser._id)){ %>
                    <a class="btn btn-default" href="/activities/<%= activity._id %>/edit">Edit task</a>
                    <form class="delete-form" action="/activities/<%= activity._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Delete task</button>
                    </form>
                <% } %>
            </div>
        </div>
        <div class="col-md-2"></div>
    </div>


<% include ../partials/footer %>