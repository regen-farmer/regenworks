<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h2>Add new area to "<%= project.name %>"</h2>
        <div>
            <form action="/projects/<%= project._id %>/areas" method="POST">
                <div class="form-group">
                    <label for="area[name]">Area name</label>
                    <input type="text" class="form-control" name="area[name]" placeholder="Give the area a name - Descriptive is often best" required>
                </div>
                <div class="form-group">
                    <label for="[layerCoordinates]">Area geometry</label>
                    <p>Please draw the outline of your new area. Press first point or "Finish" to close the shape.</p>
                </div>
                <div id="layerMapNew"></div>
                <input type="hidden" id="geometry" name="geometry">
                <input type="hidden" id="layersize" name="layersize">
                <div id="coordinates"></div>
                <hr>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Create new area</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var parcelLat = "<%= project.layer.lat %>";
        var parcelLng = "<%= project.layer.lng %>";
    </script>

<%- include('../partials/footer') %>