<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="row">
    <div class="col-md-12">
        <h2>Accounts <em>by field</em></h2>
    </div>
    <div class="col-md-12">
        <ul class="nav nav-tabs" id="myTab" role="tablist">
            <% parcel.layers.forEach(function(layer, i){ %>
                <% if(i === 0){ %>
                    <li class="nav-item">
                        <a class="nav-link active" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="true"><%= layer.name %></a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" id="layer<%= i %>-tab" data-toggle="tab" href="#layer<%= i %>" role="tab" aria-controls="layout-tab" aria-selected="false"><%= layer.name %></a>
                    </li>
                <% } %>
            <% }); %>

        </ul>
        <div class="tab-content" id="myTabContent">
            <% parcel.layers.forEach(function(layer, i){ %>
                <% if(i === 0){ %>
            <div class="tab-pane fade show active" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                <% } else { %>
                <div class="tab-pane fade" id="layer<%= i %>" role="tabpanel" aria-labelledby="layer<%= i %>-tab">

                    <% } %>
                    <div class="card">

                        <div class="card-body">
                            <h2>Accounts</h2>
                            <a class="btn btn-outline-primary" href="/parcels/<%= parcel._id %>/layers/<%= layer._id %>/accounts/postings/new">Add posting <i class="fas fa-plus"></i></a>
                            <table class="table small">
                                <tr class="table-secondary">
                                    <td>Posting</td>
                                    <td>Amount</td>
                                    <td>Price</td>
                                    <td>Total</td>
                                </tr>
                                <% if(layer.accounts.postings && layer.accounts.postings.length > 0){ %>
                                    <% for(let j=0;j<layer.accounts.postings.length;j++){ %>
                                            <td><%= layer.accounts.postings[j].name %> (<%= layer.accounts.postings[j].postType %>)</td>
                                            <td><%= layer.accounts.postings[j].amount %></td>
                                            <td><%= layer.accounts.postings[j].value %> <%= layer.accounts.currency %></td>
                                            <td><%= layer.accounts.postings[j].value * layer.accounts.postings[j].amount %> <%= layer.accounts.currency %></td>
                                        </tr>
                                        </tr>
                                    <% } %>
                                <% } %>
                            </table>
                        </div>
                    </div>

                </div>
                <% }); %>
            </div>
        </div>
    </div>

<%- include('partials/footer') %>