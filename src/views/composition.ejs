<% include ./partials/header %>
<% include ./partials/navbar %>

    <h1>System species consortium for <%= system.name %></h1>
    <p>Analyse the succession of the system to fill potential gaps.</p>
    <p><i>Shown results are based on the location of the farm.</i></p>
    <table class="table table-striped">
        <tr>
            <td></td>
            <td style="width: 30%">Pioneer</td>
            <td style="width: 30%">Secondary</td>
            <td style="width: 30%">Climax</td>
        </tr>
        <tr>
            <td>Emergent</td>
            <td><% species.forEach(function(species){ %>
                <% if(species.form == "grass"){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                <% if(species.form == "grass"){ %>
                <button class="btn btn-outline-primary" type="button" data-toggle="collapse" data-target="#collapseSuitable<%= species._id %>" aria-expanded="false" aria-controls="collapseExample">
                    <%= species.nameCommon %>
                </button>
                <div class="collapse" id="collapseSuitable<%= species._id %>">
                    <div class="card card-body">
                        <p><i><%= species.genus %> <%= species.species %></i></p>
                        <p class="card-text"><strong>Utilities:</strong>
                            <% species.utilities.forEach(function(utility){ %>
                                <%= utility %>
                            <% }); %>
                        </p>
                        <a class="btn btn-success" href="/systems/<%= system._id %>/edit/<%= species._id %>">Add <%= species.nameCommon %> to system</a>
                    </div>
                </div>
                <% } %>
                <% }); %>
                <% species.forEach(function(species){ %>
                <% if(species.form == "herb" && species.height > 1 && species.lifespan < 2){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
                    <% if(species.form == "herb" && species.height > 1 && species.lifespan < 2){ %>
                        <button class="btn btn-outline-primary" type="button" data-toggle="collapse" data-target="#collapseSuitable<%= species._id %>" aria-expanded="false" aria-controls="collapseExample">
                            <%= species.nameCommon %>
                        </button>
                        <div class="collapse" id="collapseSuitable<%= species._id %>">
                            <div class="card card-body">
                                <p><i><%= species.genus %> <%= species.species %></i></p>
                                <p class="card-text"><strong>Utilities:</strong>
                                    <% species.utilities.forEach(function(utility){ %>
                                    <%= utility %>
                                    <% }); %>
                                </p>
                                <a class="btn btn-success" href="/systems/<%= system._id %>/edit/<%= species._id %>">Add <%= species.nameCommon %> to system</a>
                            </div>
                        </div>
                    <% } %>
                <% }); %>
            </td>
            <td>
                <% species.forEach(function(species){ %>
                <% if((species.form == "tree" || species.form == "palm") && species.height > 29 && species.lifespan < 80){ %>
                <p><strong><%= species.nameCommon %></p></strong>
                <% } %>
                <% }); %>
                <% suitablespecies.forEach(function(species){ %>
