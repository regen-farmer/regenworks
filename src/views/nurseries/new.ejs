<%- include('../partials/header') %>
<%- include('../partials/nurserynav') %>

    <div class="row">

    <div class="col-lg-3"></div>

    <div class="col-lg-6">
        <h2>Create new Nursery</h2>
        <div>
            <form action="/nurseries" method="POST">
                <div class="form-group">
                    <label for="formGroupExampleInput">Name</label>
                    <input type="text" class="form-control" name="nursery[name]" placeholder="What is the name of the nursery?" required>
                </div>
                <div class="form-group">
                    <label for="formGroupExampleInput">Address/location <small>(If no exact address is available for the farm, use coordinates. Format should be as plain numbers 23.929188, 14.919198)</small></label>
                    <input type="text" class="form-control" name="nursery[location]" id="search_input" placeholder="Add location of the nursery" required>
                </div>
                <div class="form-group">
                    <label for="formGroupExampleInput">Description (Optional)</label>
                    <input type="text" class="form-control" name="nursery[description]" placeholder="Give the nursery a description">
                </div>
                <div class="form-group">
                    <label for="nursery[range]">Service range (km)</label>
                    <input type="number" max="500" class="form-control" name="nursery[range]" >
                </div>
                <div class="form-group">
                    <label for="nursery[currency]">Currency</label>
                    <select class="form-control" name="nursery[currency]">
                        <option value="usd">USD($)</option>
                        <option value="eur">EUR(€)</option>
                        <option value="gbp">GBP(£)</option>
                    </select>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg">Create Nursery</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-6"></div>
    </div>




<%- include('../partials/footer') %>