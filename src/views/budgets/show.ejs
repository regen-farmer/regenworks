<% include ../partials/header %>
<% include ../partials/navbar %>

<div>
    <h1><%= budget.name %></h1>
    <p><small>- As initial postings are automatically generated, please update values with local prices where applicable. We are continuously improving our models and dataset, but we recommend that you check all postings for most accurate budget. -</small></p>
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item">
            <p class="navbar-text">Years:</p>
        </li>
        <% for(i=1;i<years+1;i++){ %>
            <% if(i === 1){ %>
                <li class="nav-item">
                    <a class="nav-link active" id="<%= i %>-tab" data-toggle="tab" href="#year<%= i %>" role="tab" aria-controls="<%= i %>" aria-selected="false">Y <%= i %></a>
                </li>
            <% } else { %>
                <li class="nav-item">
                    <a class="nav-link" id="<%= i %>-tab" data-toggle="tab" href="#year<%= i %>" role="tab" aria-controls="<%= i %>" aria-selected="false">Y <%= i %></a>
                </li>
            <% } %>
        <% } %>
    </ul>
    <div class="tab-content" id="myTabContent">
    <% for(i=1;i<years+1;i++){ %>
        <% if(i === 1){ %>
            <div class="tab-pane fade show active" id="year<%= i %>" role="tabpanel" aria-labelledby="<%= i %>-tab">
                <table class="table small">
                    <tr class="table-secondary">
                        <td>Name</td>
                        <td>Amount</td>
                        <td>Value</td>
                        <td>Total</td>
                        <td></td>
                    </tr>
                    <% budget.postings.forEach(function(posting){ %>
                        <% if(posting.year === i){ %>
                            <tr>
                                <td><%= posting.name %> (<%= posting.postType %>)</td>
                                <td><%= posting.amount %></td>
                                <td><%= posting.value %> <%= budget.currency %></td>
                                <td><%= posting.value * posting.amount %> <%= budget.currency %></td>
                                <td><a href="/budgets/<%= budget._id %>/postings/<%= posting._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit posting</a></td>
                            </tr>
                        <% } %>
                    <% }); %>
                    <tr class="table-primary">
                        <td>Sum</td>
                        <td></td>
                        <td></td>
                        <td> </td>
                        <td></td>
                    </tr>
                </table>
            </div>
        <% } else { %>
            <div class="tab-pane fade" id="year<%= i %>" role="tabpanel" aria-labelledby="<%= i %>-tab">
                <table class="table small">
                    <tr class="table-secondary">
                        <td>Name</td>
                        <td>Amount</td>
                        <td>Value</td>
                        <td>Total</td>
                        <td></td>
                    </tr>
                    <% budget.postings.forEach(function(posting){ %>
                        <% if(posting.year === i){ %>
                            <tr>
                                <td><%= posting.name %> (<%= posting.postType %>)</td>
                                <td><%= posting.amount %></td>
                                <td><%= posting.value %> <%= budget.currency %></td>
                                <td><%= posting.value * posting.amount %> <%= budget.currency %></td>
                                <td><a href="/budgets/<%= budget._id %>/postings/<%= posting._id %>/edit" class="btn btn-sm btn-outline-secondary">Edit posting</a></td>
                            </tr>
                        <% } %>
                    <% }); %>
                    <tr class="table-primary">
                        <td>Sum</td>
                        <td></td>
                        <td></td>
                        <% total.forEach(function(year){ %>
                            <% if(year.year === i){ %>
                                <td><%= year.total %> <%= budget.currency %></td>
                            <% } %>
                        <% }); %>
                        <td></td>
                    </tr>
                </table>
            </div>
        <% } %>
    <% } %>
    </div>
    <a href="/budgets/<%= budget._id %>/postings/new" class="btn btn-outline-primary">Add new posting</a>
</div>

<% include ../partials/footer %>