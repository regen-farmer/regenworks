<% include partials/header %>
<% include partials/navbar %>

<div class="container">
    <h1>Dashboard</h1>
    <% if(parcels === undefined || activities === undefined){ %>
        <h2>Getting started</h2>
        <p>Get started using Regen Farmer FLOW and reap the benefits.</p>
        <% if(activities === undefined){ %>
            <div class="row">
                <div class="col-md-3 col-sm-6">
                    <div class="thumbnail">
                        <img class="img-responsive">
                        <div class="caption">
                            <h4>Plan your first tasks</h4>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
        <% if(parcels === undefined){ %>
        <div class="col-md-3 col-sm-6">
                <div class="thumbnail">
                    <img class="img-responsive">
                    <div class="caption">
                        <h4>Create your first parcel</h4>
                    </div>
                </div>
            </div>
        <% } %>
    <% } %>
    <div class="row">
        <div class="col-md-6 col-sm-6">
            <div class="thumbnail">
                <div class="caption">
                    <a href="/activities/new" class="btn btn-success pull-right">Add new task</a>
                    <h3>Upcoming tasks</h3>
                    <hr>
                    <div class="row">
                        <% activities.forEach(function(activity){ %>
                        <div class="col-md-12">
                            <a href="/activities/<%= activity._id %>" class="btn btn-default btn-block">
                                <p>"<%= activity.name %>" Date: <%= activity.start.date %></p>
                            </a>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-sm-6">
            <div class="thumbnail">
                <div class="caption">
                    <h3>Overdue tasks</h3>
                    <hr>
                    <div class="row">
                        <div class="col-md-12">
                            <p>You do not have any overdue tasks</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <h2>Status on regenerative projects</h2>
    <p>-- Coming Soon --</p>
    <h2>Recent activity logs</h2>
    <p>-- Coming Soon --</p>
</div>

<% include partials/footer %>