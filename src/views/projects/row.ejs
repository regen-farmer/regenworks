<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-6">
        <h2>Add row to project</h2>
        <a href="/projects/<%= project._id %>/layout" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to map</a>
        <div>
            <form action="/projects/<%= project._id %>/row" method="POST">
                <div class="form-group">
                    <label for="row[name]">Row name/ref</label>
                    <input type="text" class="form-control" name="row[name]" required>
                </div>
                <% if(sequences && sequences.length > 0){ %>
                    <div class="form-group">
                        <label for="sequenceid">Select row sequence: </label>
                        <select name="sequenceid" id="sequenceid">
                            <option value="none">None</option>
                            <% for(let i=0;i<sequences.length;i++){ %>
                                <option value="<%= sequences[i]._id %>"><%= sequences[i].name %></option>
                            <% } %>
                        </select>
                    </div>
                <% } %>
                <div class="form-group">
                    <label for="[rowCoordinates]">Row geometry</label>
                    <p>Please draw the new row. Press "Finish" to finish line.</p>
                </div>
                <div id="rowMapNew"></div>
                <input type="hidden" id="geometry" name="geometry">
                <input type="hidden" id="layersize" name="layersize">
                <div id="coordinates"></div>
                <hr>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Create new row</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var areaLat = "<%= project.layer.lat %>";
        var areaLng = "<%= project.layer.lng %>";
    </script>

<%- include('../partials/footer') %>