<% include ../partials/header %>
<% include ../partials/navbar %>

<div class="row">
    <div class="col-lg-6">
        <h2>Edit row</h2>
        <div>
            <form action="/projects/<%= project._id %>/row/<%= row._id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="row[name]">Row name/ref</label>
                    <input type="text" class="form-control" name="row[name]" value="<%= row.name %>" required>
                </div>
                <% if(sequences && sequences.length > 0){ %>
                <div class="form-group">
                    <label for="sequenceid">Select row system: </label>
                    <select name="sequenceid" id="sequenceid">
                        <option value="none">None</option>
                        <% for(let i=0;i<sequences.length;i++){ %>
                            <% if(row.sequence && sequences[i].name === row.sequence.name){ %>
                                <option value="<%= sequences[i]._id %>" selected="selected"><%= sequences[i].name %></option>
                            <% } else { %>
                                <option value="<%= sequences[i]._id %>"><%= sequences[i].name %></option>
                            <% } %>
                        <% } %>
                    </select>
                </div>
                <% } %>
                <!--   <div class="form-group">
                       <label for="[rowCoordinates]">Row geometry</label>
                       <p>Please draw the outline of your new row. Press first point or "Finish" to close the shape.</p>
                   </div>
                   <div id="rowMapNew"></div>
                   <input type="hidden" id="geometry" name="geometry">
                   <input type="hidden" id="layersize" name="layersize">
                   <div id="coordinates"></div>
                   <hr>-->
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Update row</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        var areaLat = "<%= project.layer.lat %>";
        var areaLng = "<%= project.layer.lng %>";
    </script>

<% include ../partials/footer %>