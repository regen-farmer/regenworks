<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h2>Add edge system to project <%= project.name %></h2>
        <div>
            <form action="/projects/<%= project._id %>/addedgesystem" method="POST">
                <div class="form-group">
                    <label for="systemid">Select edge system: </label>
                    <select name="systemid" id="systemid">
                        <% for(let i=0;i<systems.length;i++){ %>
                            <option value="<%= systems[i]._id %>"><%= systems[i].name %></option>
                        <% } %>
                    </select>
                </div>
                <div class="btn-group">
                    <button type="submit" class="btn btn-success btn-lg">Add system</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-3"></div>
</div>

<%- include('../partials/footer') %>