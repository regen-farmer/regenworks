                filterBy(0);

                document
                    .getElementById('slider')
                    .addEventListener('input', function (e) {
                        var month = parseInt(e.target.value, 10);
                        filterBy(month);
                    });
            }
        );*/

        map.addLayer({
            'id': 'map',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': {
                    'type': 'Feature',
                    'geometry': {
                        'type': 'Polygon',
                        'coordinates': correctgeometry.geometry.coordinates
                    }
                }
            },
            'layout': {},
            'paint': {
                'fill-color': '#b4aab4',
                'fill-opacity': 0.8,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
             'id': 'alleys',
             'type': 'fill',
             'source': {
                 'type': 'geojson',
                 'data':
