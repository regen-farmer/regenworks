<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-3"></div>
    <div class="col-lg-6">
        <h2>Edit task "<%= activity.name %>"</h2>
        <div>
            <form action="/projects/<%= project._id %>/activities/<%= activity._id %>?_method=PUT" method="POST">
                <div class="form-group">
                    <label for="activity[name]">Task name</label>
                    <input type="text" class="form-control" name="activity[name]" value="<%= activity.name %>" required>
                </div>
                <div class="form-group">
                    <label for="activity[start][date]">Date and time</label>
                    <input type="date" class="form-control" name="activity[start][date]" value="<%= activity.start.date %>" required>
                    <input type="time" class="form-control" name="activity[start][time]" value="<%= activity.start.time %>" required>
                </div>
                <div class="btn-group">
                    <button type="submit" class="btn btn-success btn-lg">Update task</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-3"></div>
</div>

<%- include('../partials/footer') %>