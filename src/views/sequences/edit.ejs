<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-12">
        <h1>Update row sequence pattern</h1>
        <p>This page lets you update an existing row sequence pattern. </p>
        <% if(project){ %>
            <form action="/projects/<%= project._id %>/sequences/<%= sequence._id %>?_method=PUT" method="POST">
        <% } else { %>
            <form action="/layers/<%= layer._id %>/sequences/<%= sequence._id %>?_method=PUT" method="POST">
        <% } %>
         <div class="form-group">
                <label for="sequence[name]">Sequence name</label>
                <input type="text" class="form-control" name="sequence[name]" value="<%= sequence.name %>" required>
            </div>
            <div class="form-group">
                <label for="sequence[description]">Description</label>
                <input type="text" class="form-control" name="sequence[description]" value="<%= sequence.description %>">
            </div>
            <h3>Sequence pattern</h3>
            <p>The species positions are absolute. </p>
            <% for(let i=0;i<(length/distance);i++){ %>
            <div class="card">
                <div class="card-body">
                    <select name="model[species]" style="width:100%;max-width:100%;">
                        <option value="">none</option>
                        <% species.forEach(function(species){ %>
                            <% var count = 0; %>
                            <% for(let k=0;k<sequence.model.length;k++){ %>
                                <% if(sequence.model[k].position === length - i*distance && sequence.model[k].species.nameCommon === species.nameCommon){ %>
                                    <option value="<%= species._id %>" selected="selected"><%= species.genus %> <%= species.species %></option>
                                <% count = 1; %>
                                <% } %>
                            <% } %>
                            <% if(count === 0){ %>
                                <option value="<%= species._id %>"><%= species.genus %> <%= species.species %></option>
                            <% } %>
                        <% }); %>
                    </select>
                    <input type="hidden" name="model[position]" value="<%= length - i*distance %>">
                    <p>Row position: <%= length - i*distance %> m</p>
                </div>
            </div>
            <% } %>
            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg mt-3">Update row sequence</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>