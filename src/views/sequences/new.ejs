<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-12">
        <h1>Create new row sequence pattern</h1>
        <p>This page lets you create a new row sequence pattern. </p>
        <% if(project){ %>
            <form action="/projects/<%= project._id %>/sequences?length=<%= length %>" method="POST">
        <% } else { %>
            <a href="/layers/<%= layer._id %>" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to area</a>
            <form action="/layers/<%= layer._id %>/sequences?length=<%= length %>" method="POST">
        <% } %>
            <div class="form-group">
                <label for="sequence[name]">Sequence name</label>
                <input type="text" class="form-control" name="sequence[name]" required>
            </div>
            <div class="form-group">
                <label for="sequence[description]">Description</label>
                <input type="text" class="form-control" name="sequence[description]">
            </div>
            <h3>Sequence pattern</h3>
            <p>The species positions are absolute. Please note that the first plants in the rows are located at the bottom.</p>
                    <h5>Row sequence</h5>
                    <% for(let i=0;i<(length/distance);i++){ %>
                    <div class="card">
                        <div class="card-body">
                            <select name="model[species]" style="width:100%;max-width:100%;">
                                <option value="">none</option>
                                <% species.forEach(function(species){ %>
                                <option value="<%= species._id %>"><%= species.genus %> <%= species.species %> (<%= species.nameCommon %>)</option>
                                <% }); %>
                            </select>
                            <input type="hidden" name="model[position]" value="<%= length - i*distance %>">
                            <p>Row position: <%= length - i*distance %> m</p>
                        </div>
                    </div>
                    <% } %>
            <div class="form-group">
                <button type="submit" class="btn btn-success btn-lg mt-3">Create new row sequence</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>