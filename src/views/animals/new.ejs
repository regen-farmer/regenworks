<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
    <div class="row">
        <div class="col-lg-3"></div>
        <div class="col-lg-6">
            <h1>Create new species</h1>
            <form action="/animals" method="POST">
                <div class="form-group">
                    <label for="animal[name]">Animal common name</label>
                    <input type="text" class="form-control" name="animal[name]" placeholder="Common name is animal" required>
                </div>
                <div class="form-group">
                    <label for="animal[genus]">Genus</label>
                    <input type="text" class="form-control" name="animal[genus]" required>
                </div>
                <div class="form-group">
                    <label for="animal[species]">Species</label>
                    <input type="text" class="form-control" name="animal[species]]" required>
                </div>
                <div class="form-group">
                    <label for="animal[family]">Family</label>
                    <input type="text" class="form-control" name="animal[family]" required>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg center-block">Create new animal</button>
                </div>
            </form>
        </div>
        <div class="col-lg-3"></div>
    </div>
</div>

<%- include('../partials/footer') %>