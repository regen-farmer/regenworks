<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-12">
        <h1>Create new crop rotation plan</h1>
        <p>This page lets you create a new crop rotation. </p>
        <% if(project){ %>
        <form action="/projects/<%= project._id %>/rotations" method="POST">
            <% } else { %>
            <a href="/layers/<%= layer._id %>" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to area</a>
            <form action="/layers/<%= layer._id %>/rotations" method="POST">
                <% } %>
                <div class="form-group">
                    <label for="rotation[name]">Rotation name/reference</label>
                    <input type="text" class="form-control" name="rotation[name]" required>
                </div>
                <div class="form-group">
                    <label for="rotation[description]">Description</label>
                    <input type="text" class="form-control" name="rotation[description]">
                </div>
                <h3>Crop rotation pattern</h3>
                <p>Select individual crop and specify planting time and harvest relative in the rotation cycle.</p>
                <% for(let i=0;i<steps;i++){ %>
                <div class="card">
                    <div class="card-body">
                        <p>Step <%= i + 1 %></p>
                        <select name="model[speciesmix][species]" style="width:100%;max-width:100%;">
                            <option value="">none</option>
                            <% species.forEach(function(species){ %>
                            <option value="<%= species._id %>"><%= species.genus %> <%= species.species %> (<%= species.nameCommon %>)</option>
                            <% }); %>
                        </select>
                        <div class="row">
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="model[planting][year]">Planting year [1 = first year]</label>
                                    <input type="number" min="1" max="25" class="form-control" name="model[planting][year]" required>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="model[planting][month]">Planting month [1-12]</label>
                                    <input type="number" min="1" max="12" class="form-control" name="model[planting][month]" required>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="model[harvest][year]">Harvest year</label>
                                    <input type="number" min="1" max="25" class="form-control" name="model[harvest][year]" required>
                                </div>
                            </div>
                            <div class="col-lg-3">
                                <div class="form-group">
                                    <label for="model[harvest][month]">Harvest month [1-12]</label>
                                    <input type="number" min="1" max="12" class="form-control" name="model[harvest][month]" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg mt-3">Create the new crop rotation</button>
                </div>
            </form>
    </div>
</div>

<%- include('../partials/footer') %>