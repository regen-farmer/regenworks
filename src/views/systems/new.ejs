<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-12">
            <h1>Create new agroforestry systems for area</h1>
            <p>This page lets you create a new agroforestry system. </p>
            <form action="/layers/<%= layer._id %>/systems" method="POST">
                <div class="form-group">
                    <label for="system[name]">System name</label>
                    <input type="text" class="form-control" name="system[name]" placeholder="Give the system a name - Descriptive is often best" required>
                </div>
                <div class="form-group">
                    <label for="system[description]">Description</label>
                    <input type="text" class="form-control" name="system[description]" placeholder="Describe the agroforestry system: apple orchard, cereal crops, grazing area, etc.">
                </div>
                <div class="form-group">
                    <label for="system[animals][0]">Animals in system (If any)</label>
                    <select name="system[animals][0]">
                        <option value="">none</option>
                        <% animals.forEach(function(animal){ %>
                        <option value="<%= animal._id %>"><%= animal.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="system[shared]" id="exampleRadios1">
                    <label class="form-check-label" for="exampleRadios1">
                        Share system with other farmers
                    </label>
                </div>
                <h3>System model</h3>
                <p>The species positions are absolute. Please note that the first plants in the rows are located at the bottom. If only one species is selected in one row, this species will automatically be extended to the whole row.</p>
                <div class="row">
                    <% for(j=0;j<rows;j++){ %>
                        <div class="col-lg-<%= Math.floor(12/rows) %>">
                            <h5>Row <%= j + 1 %></h5>
                            <div class="form-group">
                                <label for="system[model][<%= j %>][width]">Row width</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= j %>][width]" placeholder="Width in m" required>
                            </div>
                            <div class="form-group">
                                <label for="system[model][<%= j %>][distance]">Distance to next row</label>
                                <input type="number" step=".01" class="form-control" name="system[model][<%= j %>][distance]" placeholder="Distance in m" required>
                            </div>
                            <% for(i=0;i<(length/distance);i++){ %>
                            <div class="card">
                                <div class="card-body">
                                    <select name="system[model][<%= j %>][species][id]" style="width:100%;max-width:100%;">
                                        <option value="">none</option>
                                            <% species.forEach(function(species){ %>
                                        <option value="<%= species._id %>"><%= species.nameCommon %></option>
                                        <% }); %>
                                    </select>
                                    <input type="hidden" name="system[model][<%= j %>][species][y]" value="<%= length - i*distance %>">
                                    <p>Row position: <%= length - i*distance %> m</p>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-success btn-lg mt-3">Create new system</button>
                </div>
            </form>
        </div>
