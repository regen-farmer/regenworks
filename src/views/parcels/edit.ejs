<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h2>Update information for "<%= parcel.name %>"</h2>
            <div>
                <form action="/parcels/<%= parcel._id %>?_method=PUT" method="POST">
                    <p>Change the information for your farm below. </p>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Name</label>
                        <input type="text" class="form-control" name="parcel[name]" value="<%= parcel.name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Address/location <small>(If no exact address is available for the farm, use coordinates.)</small></label>
                        <input type="text" class="form-control" name="parcel[location]" id="search_input" value="<%= parcel.location %>" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Description</label>
                        <input type="text" class="form-control" name="parcel[description]" value="<%= parcel.description %>" required>
                    </div>
                    <div class="form-group">
                        <label for="formGroupExampleInput">Parcel size (Hectares)</label>
                        <input type="number" class="form-control" name="parcel[size]" value="<%= parcel.size %>">
                    </div>
                    <label for="formGroupExampleInput">Soil type</label>
                    <br>
                    <div class="form-group btn-group btn-group-toggle" data-toggle="buttons">
                        <% if(parcel.soilType === "sand"){ %>
                        <label class="btn btn-outline-primary active">
                            <input type="radio" name="parcel[soilType]" checked="checked" value="sand" autocomplete="off"> Sand
                        </label>
                        <% } else { %>
                        <label class="btn btn-outline-primary">
                            <input type="radio" name="parcel[soilType]" value="sand" autocomplete="off"> Sand
                        </label>
                        <% } %>
                        <% if(parcel.soilType === "loam"){ %>
                        <label class="btn btn-outline-primary active">
                            <input type="radio" name="parcel[soilType]" checked="checked" value="loam" autocomplete="off"> Loam
                        </label>
                        <% } else { %>
                        <label class="btn btn-outline-primary">
                            <input type="radio" name="parcel[soilType]" value="loam" autocomplete="off"> Loam
                        </label>
                        <% } %>
                        <% if(parcel.soilType === "clay"){ %>
                        <label class="btn btn-outline-primary active">
                            <input type="radio" name="parcel[soilType]" checked="checked" value="clay" autocomplete="off"> Clay
                        </label>
                        <% } else { %>
                        <label class="btn btn-outline-primary">
                            <input type="radio" name="parcel[soilType]" value="clay" autocomplete="off"> Clay
                        </label>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-success btn-lg">Update farm details</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-2"></div>
    </div>

<% include ../partials/footer %>