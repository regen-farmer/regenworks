<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-md-12">
        <div id="layerMapViz"></div>
        <a href="/parcels/<%= parcel._id %>" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to farm map</a>
    </div>

</div>

<script>
    var parcelLat = "<%= parcel.lat %>";
    var parcelLng = "<%= parcel.lng %>";

    var getcollection = "<%= collection %>";
    var correctcollection = JSON.parse(getcollection.replace(/&#34;/g,'"'));

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var alleys = "<%= alleys %>";
    var correctalleys = JSON.parse(alleys.replace(/&#34;/g,'"'));

    var strips = "<%= strips %>";
    var correctstrips = JSON.parse(strips.replace(/&#34;/g,'"'));

    var placecollection = "<%= places %>";
    var places = JSON.parse(placecollection.replace(/&#34;/g,'"'));

    mapboxgl.accessToken = 'pk.eyJ1IjoicmVnZW5mYXJtZXIiLCJhIjoiY2puazNiNTJrMHp6MjN2dGExZmx3Y2xidSJ9.w9Hya5NzRLZZO3FcS1rDyA';
    var map = new mapboxgl.Map({
        container: 'layerMapViz',
        style: 'mapbox://styles/mapbox/satellite-v9',
        center: [parcelLng, parcelLat],
        zoom: 14,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map1',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': correctcollection
            },
            'layout': {},
            'paint': {
                'fill-color': '#fff1ff',
                'fill-opacity': 0.5,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'alleys',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctalleys
            },
            'layout': {},
            'paint': {
                'fill-color': '#1EBEC8',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'strips',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctstrips
            },
            'layout': {},
            'paint': {
                'fill-color': '#002eff',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#1EBEC8',
                'fill-opacity': 0.8,
                'fill-outline-color': '#F0F8FF'
            }
        });


        /*map.addLayer({
            'id': 'poi-labels',
            'type': 'symbol',
            'source': {
                'type': 'geojson',
                'data': places
            },
            'layout': {
                'text-field': ['get', 'description'],
                'text-justify': 'center',
                'icon-image': ['concat', ['get', 'icon'], '-15']
            }
        });*/

    });
</script>

<%- include('../partials/footer') %>