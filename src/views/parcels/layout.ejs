<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-md-12">
        <div id="layerMapViz"></div>
        <a href="/parcels/<%= parcel._id %>" class="btn mt-2 mb-2 btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back to farm map</a>
    </div>

</div>

<script>
    var parcelLat = "<%= parcel.lat %>";
    var parcelLng = "<%= parcel.lng %>";

    var getcollection = "<%= collection %>";
    var correctcollection = JSON.parse(getcollection.replace(/&#34;/g,'"'));

    var trees = "<%= trees %>";
    var correcttrees = JSON.parse(trees.replace(/&#34;/g,'"'));

    var alleys = "<%= alleys %>";
    var correctalleys = JSON.parse(alleys.replace(/&#34;/g,'"'));

    var strips = "<%= strips %>";
    var correctstrips = JSON.parse(strips.replace(/&#34;/g,'"'));

    var placecollection = "<%= places %>";
    var places = JSON.parse(placecollection.replace(/&#34;/g,'"'));

    var map = new maplibregl.Map({
        container: 'layerMapViz',
        style: {
        'version': 8,
        'sources': {
        'raster-tiles': {
        'type': 'raster',
        'tiles': [
        'https://mt0.google.com/vt/lyrs=s&x={x}&y={y}&z={z}',
        'https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}',
        'https://mt2.google.com/vt/lyrs=s&x={x}&y={y}&z={z}',
        'https://mt3.google.com/vt/lyrs=s&x={x}&y={y}&z={z}'
        ],
        'tileSize': 256,
        'attribution':
        '<a target="_top" rel="noopener" href="https://maplibre.org">MapLibre</a>, <a target="_top" rel="noopener" href="https://google.com">Google</a>'
        }
        },
        'layers': [
        {
        'id': 'simple-tiles',
        'type': 'raster',
        'source': 'raster-tiles',
        'minzoom': 0,
        'maxzoom': 21
        }
        ]
        },
        center: [parcelLng, parcelLat],
        zoom: 14,
    });

    map.on('load', function () {

        map.addLayer({
            'id': 'map1',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data': correctcollection
            },
            'layout': {},
            'paint': {
                'fill-color': '#fff1ff',
                'fill-opacity': 0.5,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'alleys',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctalleys
            },
            'layout': {},
            'paint': {
                'fill-color': '#1EBEC8',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'strips',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correctstrips
            },
            'layout': {},
            'paint': {
                'fill-color': '#002eff',
                'fill-opacity': 0.6,
                'fill-outline-color': '#F0F8FF'
            }
        });

        map.addLayer({
            'id': 'map2',
            'type': 'fill',
            'source': {
                'type': 'geojson',
                'data':
                correcttrees
            },
            'layout': {},
            'paint': {
                'fill-color': '#1EBEC8',
                'fill-opacity': 0.8,
                'fill-outline-color': '#F0F8FF'
            }
        });


        /*map.addLayer({
            'id': 'poi-labels',
            'type': 'symbol',
            'source': {
                'type': 'geojson',
                'data': places
            },
            'layout': {
                'text-field': ['get', 'description'],
                'text-justify': 'center',
                'icon-image': ['concat', ['get', 'icon'], '-15']
            }
        });*/

    });
</script>

<%- include('../partials/footer') %>