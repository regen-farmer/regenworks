<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <h1><%= practice.name %></h1>
            <hr>
            <% if(practice.description){ %>
                <p><strong>Practice description:</strong> <%= practice.description %></p>
            <% } %>
        </div>
        <div class="col-md-4">
            <h2>Available actions:</h2>
            <p>Implement this practice on parcel "<%= parcel.name %>"</p>
            <a href="" class="btn btn-success">Create implemenation project (Coming soon)</a>
            <hr>
            <p>Already using this practice on parcel "<%= parcel.name %>"?</p>
            <a href="/parcels/<%= parcel.id %>/edit" class="btn btn-default">Update parcel info</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>