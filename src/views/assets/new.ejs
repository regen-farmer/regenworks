<% include ../partials/header %>
<% include ../partials/navbar %>

    <div class="row">
        <div class="col-lg-2"></div>
        <div class="col-lg-8">
            <h1>Add a new asset</h1>
            <div>
                <form action="/layers/<%= layer._id %>/assets" method="POST">
                    <p>Add a new asset to "<%= layer.name %>".</p>
                    <div class="form-group">
                        <label for="asset[name]">Asset name</label>
                        <input type="text" class="form-control" name="asset[name]" placeholder="Give the asset a name" required>
                    </div>
                    <div class="form-group">
                        <label for="asset[description]">Asset description</label>
                        <input type="text" class="form-control" name="asset[description]" placeholder="Give the asset a description" required>
                    </div>
                    <div class="form-group">
                        <label for="asset[typeAsset]">Asset type</label>
                        <select class="form-control" name="asset[typeAsset]">
                            <option value="plant">Plants</option>
                            <option value="animal">Animals</option>
                            <option value="equipment">Equipment</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="asset[amount]">Amount/count</label>
                        <input type="number" class="form-control" name="asset[amount]">
                    </div>
                    <div class="form-group">
                        <label for="asset[creation]">Age (Initial date of planting/construction)</label>
                        <input type="date" class="form-control" name="asset[creation]">
                    </div>
                    <div class="btn-group">
                        <button type="submit" class="btn btn-success btn-lg">Create asset on this area</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-2"></div>
    </div>

<% include ../partials/footer %>