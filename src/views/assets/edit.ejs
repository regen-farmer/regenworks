<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="row">
    <div class="col-lg-2"></div>
    <div class="col-lg-8">
        <h1>Edit asset</h1>
        <form action="/assets/<%= asset._id %>?_method=PUT" method="POST">
            <div class="form-group">
                <label for="asset[name]">Asset name</label>
                <input type="text" class="form-control" name="asset[name]" value="<%= asset.name %>" required>
            </div>
            <label for="asset[species]">Asset species</label>
            <select name="asset[species]" style="width:100%;max-width:100%;">
                <% species.forEach(function(species){ %>
                    <% var count = 0; %>
                        <% if(asset.species.nameCommon === species.nameCommon){ %>
                            <option value="<%= species._id %>" selected="selected"><%= species.nameCommon %></option>
                        <% count = 1; %>
                    <% } %>
                    <% if(count === 0){ %>
                        <option value="<%= species._id %>"><%= species.nameCommon %></option>
                    <% } %>
                <% }); %>
            </select>
            <div class="btn-group">
                <button type="submit" class="btn btn-success btn-lg center-block">Update asset</button>
            </div>
        </form>
    </div>
    <div class="col-lg-2"></div>
</div>

<%- include('../partials/footer') %>