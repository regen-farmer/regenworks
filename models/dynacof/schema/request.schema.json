{
  "$defs": {
    "DynacofInputs": {
      "additionalProperties": false,
      "properties": {
        "site": {
          "$ref": "#/$defs/Site"
        },
        "meteo": {
          "description": "Consecutive days, oldest first",
          "items": {
            "$ref": "#/$defs/MeteoDay"
          },
          "maxItems": 21960,
          "minItems": 1,
          "title": "Meteo",
          "type": "array"
        },
        "shade_trees": {
          "default": true,
          "description": "False would run a coffee monocrop, but DynACof 1.5.3 fails on that path (soil.jl reads wleaf_Tree, which a no-shade run doesn't have), so it is rejected for now.",
          "title": "Shade Trees",
          "type": "boolean"
        },
        "period": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "format": "date",
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only return this date range",
          "title": "Period"
        },
        "parameters": {
          "$ref": "#/$defs/Parameters"
        },
        "daily_variables": {
          "description": "DynACof output columns to return day by day, e.g. LAI, Yield_green, CM_Stem_Tree",
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Daily Variables",
          "type": "array"
        }
      },
      "required": [
        "site",
        "meteo"
      ],
      "title": "DynacofInputs",
      "type": "object"
    },
    "MeteoDay": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "tmax_c": {
          "maximum": 60,
          "minimum": -50,
          "title": "Tmax C",
          "type": "number"
        },
        "tmin_c": {
          "maximum": 50,
          "minimum": -60,
          "title": "Tmin C",
          "type": "number"
        },
        "rain_mm": {
          "default": 0.0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Rain Mm",
          "type": "number"
        },
        "rad_mj_m2": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Incident shortwave radiation (MJ m-2 d-1)",
          "title": "Rad Mj M2"
        },
        "par_mj_m2": {
          "anyOf": [
            {
              "maximum": 25,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Incident PAR (MJ m-2 d-1); used if rad is missing",
          "title": "Par Mj M2"
        },
        "rh_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rh Pct"
        },
        "tair_c": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": -50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mean air temperature; else (tmax+tmin)/2",
          "title": "Tair C"
        },
        "pressure_hpa": {
          "anyOf": [
            {
              "maximum": 1100,
              "minimum": 300,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Hpa"
        },
        "wind_m_s": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind M S"
        },
        "co2_ppm": {
          "anyOf": [
            {
              "maximum": 2000,
              "minimum": 150,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Co2 Ppm"
        },
        "vpd_hpa": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vpd Hpa"
        },
        "diffuse_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diffuse Fraction"
        },
        "degree_days": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degree Days"
        }
      },
      "required": [
        "date",
        "tmax_c",
        "tmin_c"
      ],
      "title": "MeteoDay",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "description": "Overrides of DynACof's default parameters (Vezy et al. 2019, Aquiares, Costa Rica).\n\nKeys are DynACof's own field names, e.g. coffee.Stocking_Coffee, tree.StockingTree_treeha1,\ntree.Tree_Species. Values must have the same type as the default. Model functions\n(metamodels, allometries) can't be changed. Ranges such as tree.Fall_Period_Tree are\ngiven as [[from, to], ...].",
      "properties": {
        "constants": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 100,
          "title": "Constants",
          "type": "object"
        },
        "site": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 100,
          "title": "Site",
          "type": "object"
        },
        "soil": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 100,
          "title": "Soil",
          "type": "object"
        },
        "coffee": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 200,
          "title": "Coffee",
          "type": "object"
        },
        "tree": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ]
          },
          "maxProperties": 200,
          "title": "Tree",
          "type": "object"
        }
      },
      "title": "Parameters",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "elevation_m": {
          "anyOf": [
            {
              "maximum": 6000,
              "minimum": -500,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elevation M"
        },
        "timezone_offset_h": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": -14,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DynACof 'TimezoneCF': hours to add to local time to get UTC (Costa Rica = 6)",
          "title": "Timezone Offset H"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Site",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "$ref": "#/$defs/DynacofInputs"
    }
  },
  "required": [
    "inputs"
  ],
  "title": "ExecuteRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
