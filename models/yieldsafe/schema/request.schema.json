    "Weather": {
      "additionalProperties": false,
      "description": "Daily series from `start`, one value per day, no gaps (real calendar, leap days included).",
      "properties": {
        "start": {
          "description": "Date of the first value; also the start of tree year 0",
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "temp_c": {
          "description": "Daily mean air temperature (degC)",
          "items": {
            "type": "number"
          },
          "maxItems": 40000,
          "minItems": 366,
          "title": "Temp C",
          "type": "array"
        },
        "rad_mj_m2": {
          "description": "Global radiation (MJ m-2 d-1)",
          "items": {
            "type": "number"
          },
          "maxItems": 40000,
