    "Irrigation": {
      "additionalProperties": false,
      "properties": {
        "start_year": {
          "default": 0,
          "maximum": 110,
          "minimum": 0,
          "title": "Start Year",
          "type": "integer"
        },
        "start_doy": {
          "default": 0,
          "maximum": 365,
          "minimum": 0,
          "title": "Start Doy",
          "type": "integer"
        },
        "end_year": {
          "default": 60,
          "maximum": 110,
          "minimum": 0,
          "title": "End Year",
          "type": "integer"
        },
        "end_doy": {
          "default": 180,
          "maximum": 365,
          "minimum": 0,
          "title": "End Doy",
          "type": "integer"
        },
        "interval_days": {
          "default": 10,
          "maximum": 365,
          "minimum": 1,
          "title": "Interval Days",
          "type": "integer"
        },
        "amount_mm": {
          "default": 100,
          "maximum": 500,
          "minimum": 0,
          "title": "Amount Mm",
          "type": "number"
        }
      },
      "title": "Irrigation",
      "type": "object"
    },
    "Pruning": {
      "additionalProperties": false,
      "description": "The workbook's 'horizontal prune' (management sheet AF73-AF75).",
      "properties": {
        "interval_years": {
          "default": 80,
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Interval Years",
          "type": "number"
        },
        "biomass_fraction": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Biomass Fraction",
          "type": "number"
        },
        "shoots_fraction": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Shoots Fraction",
          "type": "number"
        }
      },
      "title": "Pruning",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "description": "Recorded only: Yield-SAFE takes radiation directly, not latitude",
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "description": "Recorded only",
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Site",
      "type": "object"
    },
    "Soil": {
      "additionalProperties": false,
      "properties": {
        "texture": {
          "description": "Soil class from the workbook (worksheet C.3)",
          "enum": [
            "coarse",
            "medium",
            "medium_fine",
            "fine",
            "very_fine",
            "fine_upson_2014"
          ],
          "title": "Texture",
          "type": "string"
        },
        "vwc0": {
          "description": "Initial volumetric water content (mm/mm)",
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Vwc0",
          "type": "number"
        },
        "depth_mm": {
          "description": "Effective soil (rooting) depth",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Depth Mm",
          "type": "number"
        },
        "water_model": {
          "default": true,
          "description": "False = no water limitation (the workbook's water switch)",
          "title": "Water Model",
          "type": "boolean"
        },
        "root_shoot_ratio": {
          "default": 0.25,
          "description": "Used for root carbon",
          "maximum": 5,
          "minimum": 0,
          "title": "Root Shoot Ratio",
          "type": "number"
        },
        "overrides": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "alpha",
              "epot_mm_per_mj",
              "pf_fc",
              "ks_mm_d",
              "n_vg",
              "pf_crit_e",
              "pf_e_offset",
              "theta_s",
              "theta_r"
            ]
          },
          "title": "Overrides",
          "type": "object"
        }
      },
      "required": [
        "texture",
        "vwc0",
        "depth_mm"
      ],
      "title": "Soil",
      "type": "object"
    },
    "Tree": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "Parameter set from the Yield-SAFE v2 workbook (worksheet C.1)",
          "enum": [
            "poplar_graves_2010",
            "src",
            "miscanthus",
            "wild_cherry",
            "poplar_upson_agf",
            "poplar_for_2011",
            "apple_5_7x2_8"
          ],
          "title": "Template",
          "type": "string"
        },
        "overrides": {
          "$ref": "#/$defs/TreeOverrides"
        }
      },
      "required": [
        "template"
      ],
      "title": "Tree",
      "type": "object"
    },
