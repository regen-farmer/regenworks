            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "doy_sowing": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": -365,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Negative = sown the previous autumn",
